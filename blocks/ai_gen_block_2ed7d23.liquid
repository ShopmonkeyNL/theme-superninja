{% doc %}
  @prompt
    Seperator block with a thin line , Remove spacing settings. And border color should be referencing Color scheme border color, Add ability to choose border color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-separator-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-separator-line-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    border: none;
    margin: 0;
  }
{% endstyle %}

<div class="ai-separator-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-separator-line-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "Separator",
  "settings": [
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#E6E6E6"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Separator"
    }
  ],
  "tag": null
}
{% endschema %}
