{%- doc -%}
  Renders "Complete Your Defense" product cards carousel
  Products come from product metafield, or shows placeholder products
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign defense_products = product.metafields.custom.complete_defense_products
  
  assign use_placeholders = false
  if defense_products == blank or defense_products.value == blank
    assign use_placeholders = true
  endif
  
  comment
    Default products by handle when no metafield
  endcomment
  assign default_product_handles = 'super-ninja-fruit-fly-trap,super-ninja-fruit-fly-trap,super-ninja-fruit-fly-trap' | split: ','

  comment
    Arrow asset: product.v2 template (suffix v2) = green arrow-right.svg, else orange Capa_1.svg
  endcomment
  if template.name == 'product' and template.suffix == 'v2'
    assign arrow_asset = 'arrow-right.svg'
  else
    assign arrow_asset = 'Capa_1.svg'
  endif
-%}

<div class="pdp-complete-defense" {{ block.shopify_attributes }}>
  <h2 class="pdp-complete-defense__title">COMPLETE YOUR DEFENSE:</h2>
  
  <div class="pdp-complete-defense__container">
    <div class="pdp-complete-defense__carousel" data-complete-defense-carousel>
      <div class="pdp-complete-defense__track" data-carousel-track>
        {%- if use_placeholders -%}
          {%- comment -%} Show default products by handle {%- endcomment -%}
          {%- for handle in default_product_handles limit: 3 -%}
            {%- assign default_prod = all_products[handle] -%}
            {%- if default_prod != blank -%}
              <div class="pdp-complete-defense__card">
                <div class="pdp-complete-defense__card-image">
                  {%- if default_prod.featured_image != blank -%}
                    {{ default_prod.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: default_prod.title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: class: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="pdp-complete-defense__card-content">
                  <div class="pdp-complete-defense__card-reviews pdp-complete-defense__card-reviews--mobile">
                    <span class="pdp-complete-defense__card-stars" aria-hidden="true">
                      {% for i in (1..5) %}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
                          <path d="M12 2.2L14.99 8.26L21.68 9.23L16.84 13.95L17.98 20.62L12 17.48L6.02 20.62L7.16 13.95L2.32 9.23L9.01 8.26L12 2.2Z" fill="currentColor" />
                        </svg>
                      {% endfor %}
                    </span>
                    <span class="pdp-complete-defense__card-reviews-text">(1,247 reviews)</span>
                  </div>
                  <div class="pdp-complete-defense__card-name">{{ default_prod.title | upcase }}</div>
                  <div class="pdp-complete-defense__card-price">{{ default_prod.price | money }}</div>
                </div>
                <a href="{{ default_prod.url }}" class="pdp-complete-defense__card-button">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip0_324_16783)">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M20.8767 2.86567C20.7244 1.75117 19.7727 0.920166 18.6469 0.920166C15.6552 0.920166 8.34568 0.920166 5.35393 0.920166C4.22818 0.920166 3.27643 1.75117 3.12418 2.86567C2.63518 6.45142 1.26568 16.4977 0.715932 20.5259C0.628182 21.1694 0.823182 21.8204 1.24993 22.3094C1.67743 22.7992 2.29543 23.0797 2.94568 23.0797H21.0552C21.7054 23.0797 22.3234 22.7992 22.7509 22.3094C23.1777 21.8204 23.3727 21.1694 23.2849 20.5259L20.8767 2.86567ZM15.4504 5.68942C15.4504 7.60792 13.8927 9.16566 11.9742 9.16566C10.0557 9.16566 8.49868 7.60792 8.49868 5.68942C8.49868 5.27542 8.16268 4.93942 7.74868 4.93942C7.33468 4.93942 6.99868 5.27542 6.99868 5.68942C6.99868 8.43592 9.22843 10.6657 11.9742 10.6657C14.7207 10.6657 16.9504 8.43592 16.9504 5.68942C16.9504 5.27542 16.6144 4.93942 16.2004 4.93942C15.7864 4.93942 15.4504 5.27542 15.4504 5.68942Z" fill="#fff"></path>
                  </g>
                  <defs>
                  <clipPath id="clip0_324_16783">
                  <rect width="24" height="24" fill="white"></rect>
                  </clipPath>
                  </defs>
                  </svg>
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Use products from metafield {%- endcomment -%}
          {%- for defense_product in defense_products.value -%}
            {%- assign prod = defense_product -%}
            {%- if prod == blank -%}
              {%- continue -%}
            {%- endif -%}
            
            <div class="pdp-complete-defense__card">
              <div class="pdp-complete-defense__card-image">
                {%- if prod.featured_image != blank -%}
                  {{ prod.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: prod.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: class: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="pdp-complete-defense__card-content">
                <div class="pdp-complete-defense__card-reviews pdp-complete-defense__card-reviews--mobile">
                  <span class="pdp-complete-defense__card-stars" aria-hidden="true">
                    {% for i in (1..5) %}
                      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
                        <path d="M12 2.2L14.99 8.26L21.68 9.23L16.84 13.95L17.98 20.62L12 17.48L6.02 20.62L7.16 13.95L2.32 9.23L9.01 8.26L12 2.2Z" fill="currentColor" />
                      </svg>
                    {% endfor %}
                  </span>
                  <span class="pdp-complete-defense__card-reviews-text">(1,247 reviews)</span>
                </div>
                <div class="pdp-complete-defense__card-name">{{ prod.title | upcase }}</div>
                <div class="pdp-complete-defense__card-price">{{ prod.price | money }}</div>
              </div>
              <a href="{{ prod.url }}" class="pdp-complete-defense__card-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip0_324_16783)">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M20.8767 2.86567C20.7244 1.75117 19.7727 0.920166 18.6469 0.920166C15.6552 0.920166 8.34568 0.920166 5.35393 0.920166C4.22818 0.920166 3.27643 1.75117 3.12418 2.86567C2.63518 6.45142 1.26568 16.4977 0.715932 20.5259C0.628182 21.1694 0.823182 21.8204 1.24993 22.3094C1.67743 22.7992 2.29543 23.0797 2.94568 23.0797H21.0552C21.7054 23.0797 22.3234 22.7992 22.7509 22.3094C23.1777 21.8204 23.3727 21.1694 23.2849 20.5259L20.8767 2.86567ZM15.4504 5.68942C15.4504 7.60792 13.8927 9.16566 11.9742 9.16566C10.0557 9.16566 8.49868 7.60792 8.49868 5.68942C8.49868 5.27542 8.16268 4.93942 7.74868 4.93942C7.33468 4.93942 6.99868 5.27542 6.99868 5.68942C6.99868 8.43592 9.22843 10.6657 11.9742 10.6657C14.7207 10.6657 16.9504 8.43592 16.9504 5.68942C16.9504 5.27542 16.6144 4.93942 16.2004 4.93942C15.7864 4.93942 15.4504 5.27542 15.4504 5.68942Z" fill="#fff"></path>
                  </g>
                  <defs>
                  <clipPath id="clip0_324_16783">
                  <rect width="24" height="24" fill="white"></rect>
                  </clipPath>
                  </defs>
                </svg>
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      
      {%- liquid
        assign cards_count = 0
        if use_placeholders
          assign cards_count = 3
        else
          assign cards_count = defense_products.value.size
        endif
      -%}
      {%- if cards_count > 1 -%}
        <button class="pdp-complete-defense__arrow pdp-complete-defense__arrow--prev" type="button" aria-label="Previous products">
          <img src="{{ arrow_asset | asset_url }}" alt="" width="36" height="36" class="pdp-complete-defense__arrow-icon pdp-complete-defense__arrow-icon--prev" loading="lazy">
        </button>
        <button class="pdp-complete-defense__arrow pdp-complete-defense__arrow--next" type="button" aria-label="Next products">
          <img src="{{ arrow_asset | asset_url }}" alt="" width="36" height="36" class="pdp-complete-defense__arrow-icon" loading="lazy">
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .pdp-complete-defense {
    width: 100%;
    background-color: #F0F2F1;
  }

  .pdp-complete-defense__title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 32px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #1C1C1C;
    margin: 0 0 10px 0;
    text-align: left;
  }

  .pdp-complete-defense__container {
    width: 100%;
    max-width: 1312px;
    margin: 0 auto;
  }

  .pdp-complete-defense__carousel {
    position: relative;
    width: 100%;
  }

  .pdp-complete-defense__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 8px;
    -webkit-overflow-scrolling: touch;
    overflow-y: hidden;
  }

  .pdp-complete-defense__track::-webkit-scrollbar {
    display: none;
  }

  .pdp-complete-defense__card {
    flex: 0 0 calc(66.666% - 8px);
    max-width: 341px;
    width: 100%;
    background: #FFFFFF;
    border-radius: 8px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    scroll-snap-align: start;
    position: relative;
  }

  .pdp-complete-defense__card-image {
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F5F5F5;
    border-radius: 4px;
    overflow: hidden;
  }

  .pdp-complete-defense__card-image img,
  .pdp-complete-defense__card-image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-complete-defense__card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .pdp-complete-defense__card-reviews {
    display: none;
  }

  .pdp-complete-defense__card-stars {
    display: inline-flex;
    align-items: center;
    gap: 0;
    color: #FF5000;
  }

  .pdp-complete-defense__card-stars svg {
    width: 18px;
    height: 18px;
  }

  .pdp-complete-defense__card-reviews-text {
    font-size: 12px;
    color: #1C1C1C;
    margin-left: 4px;
  }

  .pdp-complete-defense__card-name {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #FF5000;
  }

  .pdp-complete-defense__card-price {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    color: #1C1C1C;
  }

  .pdp-complete-defense__card-button {
    flex-shrink: 0;
    padding: 12px 24px;
    background: #94D357;
    color: #1C1C1C;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .pdp-complete-defense__card-button:hover {
    opacity: 0.9;
  }

  .pdp-complete-defense__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 1000;
  }

  .pdp-complete-defense__arrow:hover {
    opacity: 0.9;
  }

  .pdp-complete-defense__arrow-icon {
    width: 36px;
    height: 36px;
    display: block;
  }

  .pdp-complete-defense__arrow-icon--prev {
    transform: rotate(180deg);
  }

  .pdp-complete-defense__arrow--prev {
    left: -18px;
  }

  .pdp-complete-defense__arrow--next {
    right: -18px;
  }

  .pdp-complete-defense__arrow--hidden {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .pdp-complete-defense__card {
      max-width: 341px;
    }

  }

  @media screen and (max-width: 749px) {
    .pdp-complete-defense__card-reviews--mobile {
      display: flex;
      align-items: center;
    }

    .pdp-complete-defense__card {
      flex: 0 0 calc(85% - 8px);
      max-width: 303px;
    }

    .pdp-complete-defense__card-image {
      width: 54px;
      height: 54px;
    }

    .pdp-complete-defense__card-name {
      font-size: 20px;
    }

    .pdp-complete-defense__card-price {
      font-size: 20px;
    }

    .pdp-complete-defense__card-button {
      padding: 10px 20px;
      font-size: 12px;
    }
    .pdp-complete-defense__arrow--next, .pdp-complete-defense__arrow--prev{
     display:none!important
    }
      .pdp-complete-defense__track {
        flex-direction: column !important;
      }
      .pdp-complete-defense__card {
        max-width: none !important;
      }
  }
</style>

<script>
  (function() {
    const carousel = document.querySelector('[data-complete-defense-carousel]');
    if (!carousel) return;

    const track = carousel.querySelector('[data-carousel-track]');
    const prevArrow = carousel.querySelector('.pdp-complete-defense__arrow--prev');
    const nextArrow = carousel.querySelector('.pdp-complete-defense__arrow--next');

    if (!track) return;

    function updateArrowStates() {
      if (!nextArrow && !prevArrow) return;

      const scrollLeft = track.scrollLeft;
      const scrollWidth = track.scrollWidth;
      const clientWidth = track.clientWidth;
      const scrollRight = scrollWidth - clientWidth;
      
      // Use a small threshold to account for sub-pixel scrolling
      const threshold = 10;
      const canScrollLeft = scrollLeft > threshold;
      const canScrollRight = scrollLeft < scrollRight - threshold;

      if (prevArrow) {
        if (canScrollLeft) {
          prevArrow.classList.remove('pdp-complete-defense__arrow--hidden');
        } else {
          prevArrow.classList.add('pdp-complete-defense__arrow--hidden');
        }
      }

      if (nextArrow) {
        if (canScrollRight) {
          nextArrow.classList.remove('pdp-complete-defense__arrow--hidden');
        } else {
          nextArrow.classList.add('pdp-complete-defense__arrow--hidden');
        }
      }
    }

    function scrollCarousel(direction) {
      const cardWidth = track.querySelector('.pdp-complete-defense__card')?.offsetWidth || 0;
      const scrollAmount = cardWidth + 16; // card width + gap
      
      track.scrollBy({
        left: direction === 'next' ? scrollAmount : -scrollAmount,
        behavior: 'smooth'
      });
    }

    if (prevArrow) {
      prevArrow.addEventListener('click', () => scrollCarousel('prev'));
    }

    if (nextArrow) {
      nextArrow.addEventListener('click', () => scrollCarousel('next'));
    }

    // Update arrow states on scroll
    track.addEventListener('scroll', updateArrowStates);
    
    // Initial arrow state - check after a small delay to ensure layout is complete
    setTimeout(() => {
      updateArrowStates();
    }, 100);
    
    // Also check on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateArrowStates);
    } else {
      updateArrowStates();
    }

    // Check if arrows are needed on resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateArrowStates();
      }, 250);
    });
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateArrowStates();
      }, 250);
    });
  })();
</script>

{% schema %}
{
  "name": "PDP Complete Your Defense",
  "tag": "div",
  "settings": []
}
{% endschema %}
