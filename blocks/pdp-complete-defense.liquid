{%- doc -%}
  Renders "Complete Your Defense" product cards carousel
  Products come from product metafield, or shows placeholder products
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign defense_products = product.metafields.custom.complete_defense_products
  
  assign use_placeholders = false
  if defense_products == blank or defense_products.value == blank
    assign use_placeholders = true
  endif
  
  comment
    Default products by handle when no metafield
  endcomment
  assign default_product_handles = 'super-ninja-fruit-fly-trap,super-ninja-fruit-fly-trap,super-ninja-fruit-fly-trap' | split: ','

  comment
    Arrow asset: product.v2 template (suffix v2) = green arrow-right.svg, else orange Capa_1.svg
  endcomment
  if template.name == 'product' and template.suffix == 'v2'
    assign arrow_asset = 'arrow-right.svg'
  else
    assign arrow_asset = 'Capa_1.svg'
  endif
-%}

<div class="pdp-complete-defense" {{ block.shopify_attributes }}>
  <h2 class="pdp-complete-defense__title">COMPLETE YOUR DEFENSE:</h2>
  
  <div class="pdp-complete-defense__container">
    <div class="pdp-complete-defense__carousel" data-complete-defense-carousel>
      <div class="pdp-complete-defense__track" data-carousel-track>
        {%- if use_placeholders -%}
          {%- comment -%} Show default products by handle {%- endcomment -%}
          {%- for handle in default_product_handles limit: 3 -%}
            {%- assign default_prod = all_products[handle] -%}
            {%- if default_prod != blank -%}
              {%- assign default_form_id = 'pdp-complete-defense-form-' | append: block.id | append: '-default-' | append: forloop.index0 -%}
              {% render 'pdp-complete-defense-card', card_product: default_prod, section_id: section.id, form_id: default_form_id %}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Use products from metafield {%- endcomment -%}
          {%- for defense_product in defense_products.value -%}
            {%- assign prod = defense_product -%}
            {%- if prod == blank -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign prod_form_id = 'pdp-complete-defense-form-' | append: block.id | append: '-product-' | append: forloop.index0 -%}
            {% render 'pdp-complete-defense-card', card_product: prod, section_id: section.id, form_id: prod_form_id %}
          {%- endfor -%}
        {%- endif -%}
      </div>
      
      {%- liquid
        assign cards_count = 0
        if use_placeholders
          assign cards_count = 3
        else
          assign cards_count = defense_products.value.size
        endif
      -%}
      {%- if cards_count > 1 -%}
        <button class="pdp-complete-defense__arrow pdp-complete-defense__arrow--prev" type="button" aria-label="Previous products">
          <img src="{{ arrow_asset | asset_url }}" alt="" width="36" height="36" class="pdp-complete-defense__arrow-icon pdp-complete-defense__arrow-icon--prev" loading="lazy">
        </button>
        <button class="pdp-complete-defense__arrow pdp-complete-defense__arrow--next" type="button" aria-label="Next products">
          <img src="{{ arrow_asset | asset_url }}" alt="" width="36" height="36" class="pdp-complete-defense__arrow-icon" loading="lazy">
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .pdp-complete-defense {
    width: 100%;
    background-color: #F0F2F1;
  }

  .pdp-complete-defense__title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 32px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #1C1C1C;
    margin: 0 0 10px 0;
    text-align: left;
  }

  .pdp-complete-defense__container {
    width: 100%;
    max-width: 1312px;
    margin: 0 auto;
  }

  .pdp-complete-defense__carousel {
    position: relative;
    width: 100%;
  }

  .pdp-complete-defense__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 8px;
    -webkit-overflow-scrolling: touch;
    overflow-y: hidden;
  }

  .pdp-complete-defense__track::-webkit-scrollbar {
    display: none;
  }

  .pdp-complete-defense__card {
    flex: 0 0 calc(66.666% - 8px);
    max-width: 341px;
    width: 100%;
    background: #FFFFFF;
    border-radius: 8px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    scroll-snap-align: start;
    position: relative;
  }

  .pdp-complete-defense__card-image {
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F5F5F5;
    border-radius: 4px;
    overflow: hidden;
  }

  .pdp-complete-defense__card-image img,
  .pdp-complete-defense__card-image .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-complete-defense__card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .pdp-complete-defense__card-button {
    position: relative;
  }

  .pdp-complete-defense__card-reviews {
    display: none;
  }

  .pdp-complete-defense__card-stars {
    display: inline-flex;
    align-items: center;
    gap: 0;
    color: #FF5000;
  }

  .pdp-complete-defense__card-stars svg {
    width: 18px;
    height: 18px;
  }

  .pdp-complete-defense__card-reviews-text {
    font-size: 12px;
    color: #1C1C1C;
    margin-left: 4px;
  }

  .pdp-complete-defense__card-name {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #FF5000;
  }

  .pdp-complete-defense__card-price {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    color: #1C1C1C;
  }

  .pdp-complete-defense__card-form .shopify-product-form {
    display: flex;
  }

  .pdp-complete-defense__card-button {
    flex-shrink: 0;
    padding: 12px 24px;
    background: #94D357;
    color: #1C1C1C;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    border: none;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .pdp-complete-defense__card-button .add-to-cart-text {
    gap: 0;
  }

  .pdp-complete-defense__card-button .add-to-cart-text__content {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pdp-complete-defense__card-button .add-to-cart-icon {
    width: 24px;
    height: 24px;
  }

  .pdp-complete-defense__card-button .add-to-cart-icon svg {
    display: none;
  }

  .pdp-complete-defense__card-button .add-to-cart-icon::before {
    content: '';
    display: block;
    width: 24px;
    height: 24px;
    background-color: #fff;
    -webkit-mask-image: url('{{ 'icon-cart.svg' | asset_url }}');
    mask-image: url('{{ 'icon-cart.svg' | asset_url }}');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .pdp-complete-defense__card-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pdp-complete-defense__card-button:hover {
    opacity: 0.9;
  }

  .pdp-complete-defense__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.2s ease-in-out, visibility 0.2s ease;
    z-index: 1000;
    border-radius: 100%;
    box-shadow: 0 1px 5px 0px rgb(0 0 0 / 7%);
  }

  .pdp-complete-defense__arrow-icon {
    width: 36px;
    height: 36px;
    display: block;
  }

  .pdp-complete-defense__arrow-icon--prev {
    transform: rotate(180deg);
  }

  .pdp-complete-defense__arrow--prev {
    left: -18px;
  }

  .pdp-complete-defense__arrow--next {
    right: -18px;
  }

  .pdp-complete-defense__arrow--next:hover {
    transform: translateY(-50%) translateX(1px);
  }

  .pdp-complete-defense__arrow--prev:hover {
    transform: translateY(-50%) translateX(-1px);
  }

  .pdp-complete-defense__arrow--hidden {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .pdp-complete-defense__card {
      max-width: 341px;
    }

  }

  @media screen and (max-width: 749px) {
    .pdp-complete-defense__card-reviews--mobile {
      display: flex;
      align-items: center;
    }

    .pdp-complete-defense__card {
      flex: 0 0 calc(85% - 8px);
      max-width: 303px;
    }

    .pdp-complete-defense__card-image {
      width: 54px;
      height: 54px;
    }

    .pdp-complete-defense__card-name {
      font-size: 20px;
    }

    .pdp-complete-defense__card-price {
      font-size: 20px;
    }

    .pdp-complete-defense__card-button {
      padding: 10px 20px;
      font-size: 12px;
    }
    .pdp-complete-defense__arrow--next, .pdp-complete-defense__arrow--prev{
     display:none!important
    }
      .pdp-complete-defense__track {
        flex-direction: column !important;
      }
      .pdp-complete-defense__card {
        max-width: none !important;
      }
  }
</style>

<script>
  (function() {
    const carousel = document.querySelector('[data-complete-defense-carousel]');
    if (!carousel) return;

    const track = carousel.querySelector('[data-carousel-track]');
    const prevArrow = carousel.querySelector('.pdp-complete-defense__arrow--prev');
    const nextArrow = carousel.querySelector('.pdp-complete-defense__arrow--next');

    if (!track) return;

    function updateArrowStates() {
      if (!nextArrow && !prevArrow) return;

      const scrollLeft = track.scrollLeft;
      const scrollWidth = track.scrollWidth;
      const clientWidth = track.clientWidth;
      const scrollRight = scrollWidth - clientWidth;
      
      // Use a small threshold to account for sub-pixel scrolling
      const threshold = 10;
      const canScrollLeft = scrollLeft > threshold;
      const canScrollRight = scrollLeft < scrollRight - threshold;

      if (prevArrow) {
        if (canScrollLeft) {
          prevArrow.classList.remove('pdp-complete-defense__arrow--hidden');
        } else {
          prevArrow.classList.add('pdp-complete-defense__arrow--hidden');
        }
      }

      if (nextArrow) {
        if (canScrollRight) {
          nextArrow.classList.remove('pdp-complete-defense__arrow--hidden');
        } else {
          nextArrow.classList.add('pdp-complete-defense__arrow--hidden');
        }
      }
    }

    function scrollCarousel(direction) {
      const cardWidth = track.querySelector('.pdp-complete-defense__card')?.offsetWidth || 0;
      const scrollAmount = cardWidth + 16; // card width + gap
      
      track.scrollBy({
        left: direction === 'next' ? scrollAmount : -scrollAmount,
        behavior: 'smooth'
      });
    }

    if (prevArrow) {
      prevArrow.addEventListener('click', () => scrollCarousel('prev'));
    }

    if (nextArrow) {
      nextArrow.addEventListener('click', () => scrollCarousel('next'));
    }

    // Update arrow states on scroll
    track.addEventListener('scroll', updateArrowStates);
    
    // Initial arrow state - check after a small delay to ensure layout is complete
    setTimeout(() => {
      updateArrowStates();
    }, 100);
    
    // Also check on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateArrowStates);
    } else {
      updateArrowStates();
    }

    // Check if arrows are needed on resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateArrowStates();
      }, 250);
    });
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateArrowStates();
      }, 250);
    });
  })();
</script>

{% schema %}
{
  "name": "PDP Complete Your Defense",
  "tag": "div",
  "settings": []
}
{% endschema %}
