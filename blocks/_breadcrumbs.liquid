{% assign position = 1 %}

<nav aria-label="breadcrumb" class="breadcrumbs" >
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">

    {% comment %} Home {% endcomment %}
    {% render 'breadcrumb-list-item' url: shop.url, name: 'Home', position: position %}
    
    {% comment %} If productpage & product is inside one or more collections {% endcomment %}
    {% if product %}
      {% if product.collections %}
        {% assign position = position | plus: 1 %}

        <li aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</li>
        {% render 'breadcrumb-list-item' url: product.collections.last.url, name: product.collections.last.title, position: position %}
      {% endif %}

      {% assign position = position | plus: 1 %}

      <li aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</li>
      {% render 'breadcrumb-list-item' last: true, name: product.title, position: position %}
    {% endif %}

    {% comment %} If on collectionpage {% endcomment %}
    {% if collection %}
      {% assign position = position | plus: 1 %}

      <li aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</li>
      {% render 'breadcrumb-list-item' last: true, name: collection.title, position: position %}
    {% endif %}
  </ol>
</nav>

{% style %}
  .breadcrumbs ol {
    padding: 0;
    margin: 0;
    padding-block-end: 2rem;

    display: flex;
    column-gap: 1rem;
    flex-wrap: wrap;
    align-items: center;

    font-size: 1rem;

    & > li {
      list-style: none;
      display: flex;
    }

    & svg {
      height: 10px;
    }

    & a {
      transition: opacity 0.2s ease-out;
      
      &:hover {
        opacity: 0.6;
        transition: opacity 0.2s ease-out;
      }
    }
    
    
    & .breadcrumbs__last {
      font-weight: bold;
      color: var(--color-primary-button-background);
    }
  }
  {% endstyle %}

{% schema %}
{
  "name": "Breadcrumbs",
    "presets": [
      {
        "name": "Breadcrumbs"
      }
    ]
  }
{% endschema %}