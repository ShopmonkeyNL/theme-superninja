{%- liquid
  assign position = 1
  assign main_collection = collection | default: product.collections.last
-%}

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">

    {% comment %} Home {% endcomment %}
    {% render 'breadcrumb-list-item', url: routes.root_url, name: 'Home', position: position %}

    {% comment %} Productpagina: Home > Collectie > Product {% endcomment %}
    {% if template.name == 'product' %}
      {% if main_collection %}
        {% assign position = position | plus: 1 %}

        <li aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</li>
        {% render 'breadcrumb-list-item', url: main_collection.url, name: main_collection.title, position: position %}
      {% endif %}

      {% assign position = position | plus: 1 %}

      <li aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</li>
      {% render 'breadcrumb-list-item', last: true, name: product.title, position: position %}

    {% comment %} Collectiepagina: Home > Collectie {% endcomment %}
    {% elsif template.name == 'collection' %}
      {% assign position = position | plus: 1 %}

      <li aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</li>
      {% render 'breadcrumb-list-item', last: true, name: collection.title, position: position %}
    {% endif %}

  </ol>
</nav>

{% if template.name == 'collection' %}
  {% style %}
    @media (max-width: 749px) {
      #shopify-block-{{ block.id }} {
        padding-inline: var(--padding-lg);
      }
    }
  {% endstyle %}
{% endif %}

{% style %}
  .breadcrumbs ol {
    padding: 0;
    margin: 0;
    padding-block-end: 2rem;

    display: flex;
    column-gap: 1rem;
    flex-wrap: wrap;
    align-items: center;

    font-size: 1rem;

    & > li {
      list-style: none;
      display: flex;
    }

    & svg {
      height: 10px;
    }

    & a {
      transition: opacity 0.2s ease-out;
      
      &:hover {
        opacity: 0.6;
        transition: opacity 0.2s ease-out;
      }
    }
    
    
    & .breadcrumbs__last {
      font-weight: bold;
      color: var(--color-primary-button-background);
    }
  }
  {% endstyle %}

{% schema %}
{
  "name": "Breadcrumbs",
    "presets": [
      {
        "name": "Breadcrumbs"
      }
    ]
  }
{% endschema %}