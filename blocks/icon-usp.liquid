<div class="icon-usps">
  {% for i in (1..3) %}
    <div class="icon-usps__item">
      <div class="item-icon">icon</div>
      <div class="item-content">text</div>
    </div>
  {% endfor %}
</div>

{% style %}
  #shopify-block-{{ block.id }} {
      width: 100%;
  }

  .icon-usps {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    width: 100%;

    & .icon-usps__item {
      border: var(--border-width) solid var(--border-color);
      padding: 1.5rem;
      border-radius: 2px;
      flex: 1;

      display: flex;
      gap: 1rem;

      & .item-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        
        padding: 1.5rem;
        aspect-ratio: 1;
        background-color: var(--color-primary-button-background);
      }
    }
  }
{% endstyle %}

{% schema %}
  {
    "name": "Icon USPs",
    "presets": [
      {
        "name": "Icon USPs"
      }
    ]
  }
{% endschema %}