{% assign video_metaobject = metaobjects.video_stories.values %}

<div class='video-stories'>
  <div class='swiper video-stories__slider'>
      <div class='swiper-wrapper'>
        {% for video in video_metaobject %}
          <div class='swiper-slide'>
            {% render 'video',
              video: video.video.value,
              video_autoplay: false,
              video_loop: true,
              section_id: section.id
            %}
          </div>
        {% endfor %}
      </div>

    </div>
    <div class='videos-stories__prev'>
      {%- render 'slideshow-arrow', action: 'previous', icon_style: icon_style, icon_shape: shape -%}
    </div>
    <div class='videos-stories__next'>
      {%- render 'slideshow-arrow', action: 'next', icon_style: icon_style, icon_shape: shape -%}
    </div>
</div>

{% style %}
  #shopify-block-{{ block.id }} {
    width: 100%;
    position: relative;

    .video-stories deferred-media img,
    .video-stories deferred-media video {
      border-radius: 4px;
    }

    .videos-stories__prev {
      position: absolute;
      left: -1rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
    }

    .videos-stories__next {
      position: absolute;
      right: -1rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
    }

    .videos-stories__next button,
    .videos-stories__prev button {
      display: flex;
      justify-content: center;
      align-items: center;

      background: var(--color-primary-button-background);
      padding: 0.5rem;
      border-radius: 64px;
    }

    .video-stories .icon-arrow,
    .video-stories .icon-arrow svg {
      width: 1rem;
      height: 1rem;
    }

    .video-stories .swiper-button-disabled {
      display: none;
    }

    .swiper.video-stories__slider {
      overflow: hidden;
    }
  }
{% endstyle %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const videoStoriesSwiper = new Swiper('.swiper.video-stories__slider', {
      slidesPerView: 1.5,
      spaceBetween: 8,
      breakpoints: {
        420: {
          slidesPerView: 2.5,
        },
        576: {
          spaceBetween: 16,
          slidesPerView: 3.5,
        },
        992: {
          slidesPerView: 5,
        },
      },
      autoplay: {
        delay: 5000,
      },
      navigation: {
        prevEl: '.videos-stories__prev',
        nextEl: '.videos-stories__next',
      },
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Videos stories",
  "presets": [
    {
      "name": "Video stories"
    }
  ]
}
{% endschema %}
