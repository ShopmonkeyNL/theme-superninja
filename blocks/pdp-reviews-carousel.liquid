{%- doc -%}
  Wrapper for reviews carousel
  Collects all pdp-review-item blocks and creates auto-rotating carousel
{%- enddoc -%}

{%- liquid
  # Get all review items from the section
  assign review_items = section.blocks | where: 'type', 'pdp-review-item'
  
  if review_items.size == 0
    assign use_defaults = true
  endif
  
  if use_defaults
    assign review_count = 3
  else
    assign review_count = review_items.size
  endif
  assign show_arrows = false
  if review_count > 1
    assign show_arrows = true
  endif

  # Arrow asset: product.v2 template (suffix v2) = green arrow-right.svg, else orange Capa_1.svg
  if template.name == 'product' and template.suffix == 'v2'
    assign arrow_asset = 'arrow-right.svg'
  else
    assign arrow_asset = 'Capa_1.svg'
  endif
-%}

<div class="pdp-reviews-carousel" {{ block.shopify_attributes }}>
  <div class="pdp-reviews-carousel__container">
    {%- if use_defaults -%}
      {%- comment -%} Default reviews {%- endcomment -%}
      <div class="pdp-review-item pdp-review-item--active" data-review-index="0">
        <div class="pdp-review-item__header">
          <div class="pdp-review-item__name">SARAH M.</div>
          <div class="pdp-review-item__stars" aria-label="5 stars">
            {%- for i in (1..5) -%}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M8 0L10.1631 5.52786L16 6.11146L12 10.0557L12.9443 16L8 13.1631L3.05573 16L4 10.0557L0 6.11146L5.83686 5.52786L8 0Z" fill="#FF5000"/>
              </svg>
            {%- endfor -%}
          </div>
        </div>
        <div class="pdp-review-item__message">"Worked overnight! I couldn't believe how fast the fruit flies disappeared. So much better than those vinegar traps."</div>
      </div>
      
      <div class="pdp-review-item" data-review-index="1">
        <div class="pdp-review-item__header">
          <div class="pdp-review-item__name">JOHN D.</div>
          <div class="pdp-review-item__stars" aria-label="5 stars">
            {%- for i in (1..5) -%}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M8 0L10.1631 5.52786L16 6.11146L12 10.0557L12.9443 16L8 13.1631L3.05573 16L4 10.0557L0 6.11146L5.83686 5.52786L8 0Z" fill="#FF5000"/>
              </svg>
            {%- endfor -%}
          </div>
        </div>
        <div class="pdp-review-item__message">"Finally, a solution that actually works! My kitchen is fruit fly free and I couldn't be happier with the results."</div>
      </div>
      
      <div class="pdp-review-item" data-review-index="2">
        <div class="pdp-review-item__header">
          <div class="pdp-review-item__name">MARIA L.</div>
          <div class="pdp-review-item__stars" aria-label="5 stars">
            {%- for i in (1..5) -%}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M8 0L10.1631 5.52786L16 6.11146L12 10.0557L12.9443 16L8 13.1631L3.05573 16L4 10.0557L0 6.11146L5.83686 5.52786L8 0Z" fill="#FF5000"/>
              </svg>
            {%- endfor -%}
          </div>
        </div>
        <div class="pdp-review-item__message">"Easy to use, safe around my kids and pets, and incredibly effective. Highly recommend!"</div>
      </div>
    {%- else -%}
      {%- for review_block in review_items -%}
        <div class="pdp-review-item{% if forloop.first %} pdp-review-item--active{% endif %}" data-review-index="{{ forloop.index0 }}">
          <div class="pdp-review-item__header">
            <div class="pdp-review-item__name">{{ review_block.settings.customer_name }}</div>
            <div class="pdp-review-item__stars" aria-label="{{ review_block.settings.rating | default: 5 }} stars">
              {%- assign rating = review_block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M8 0L10.1631 5.52786L16 6.11146L12 10.0557L12.9443 16L8 13.1631L3.05573 16L4 10.0557L0 6.11146L5.83686 5.52786L8 0Z" fill="{% if i <= rating %}#FF5000{% else %}#E5E5E5{% endif %}"/>
                </svg>
              {%- endfor -%}
            </div>
          </div>
          <div class="pdp-review-item__message">{{ review_block.settings.message }}</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if show_arrows -%}
    <button class="pdp-reviews-carousel__arrow pdp-reviews-carousel__arrow--prev" type="button" aria-label="Previous review">
      <img src="{{ arrow_asset | asset_url }}" alt="" width="36" height="36" class="pdp-reviews-carousel__arrow-icon pdp-reviews-carousel__arrow-icon--prev" loading="lazy">
    </button>
    <button class="pdp-reviews-carousel__arrow pdp-reviews-carousel__arrow--next" type="button" aria-label="Next review">
      <img src="{{ arrow_asset | asset_url }}" alt="" width="36" height="36" class="pdp-reviews-carousel__arrow-icon" loading="lazy">
    </button>
  {%- endif -%}
</div>

<style>
  .pdp-reviews-carousel {
    width: 100%;
    position: relative;
  }

  .pdp-reviews-carousel__container {
    position: relative;
    min-height: 120px;
  }

  .pdp-reviews-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .pdp-reviews-carousel__arrow:hover {
    opacity: 0.9;
  }

  .pdp-reviews-carousel__arrow-icon {
    width: 36px;
    height: 36px;
    display: block;
  }

  .pdp-reviews-carousel__arrow-icon--prev {
    transform: rotate(180deg);
  }

  .pdp-reviews-carousel__arrow--prev {
    left: -18px;
  }

  .pdp-reviews-carousel__arrow--next {
    right: -18px;
  }

  @media screen and (max-width: 749px) {
    .pdp-reviews-carousel__arrow--prev,
    .pdp-reviews-carousel__arrow--next {
      display: none !important;
    }
  }

  .pdp-reviews-carousel__container .pdp-review-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 24px;
    background: #FFFFFF;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .pdp-reviews-carousel__container .pdp-review-item--active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .pdp-reviews-carousel__container .pdp-review-item__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 12px;
  }

  .pdp-reviews-carousel__container .pdp-review-item__name {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-style: normal;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0px;
    text-transform: uppercase;
    color: #1C1C1C;
  }

  .pdp-reviews-carousel__container .pdp-review-item__stars {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .pdp-reviews-carousel__container .pdp-review-item__message {
    font-family: Tahoma, sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 14px;
    line-height: 150%;
    letter-spacing: 0%;
    color: #1C1C1C;
  }

  @media screen and (min-width: 750px) {
    .pdp-reviews-carousel__container .pdp-review-item__name {
      font-size: 22px;
    }

    .pdp-reviews-carousel__container .pdp-review-item__message {
      font-size: 18px;
    }
  }
</style>

<script>
  (function() {
    const carousel = document.querySelector('.pdp-reviews-carousel');
    if (!carousel) return;

    const items = carousel.querySelectorAll('.pdp-review-item');
    if (items.length <= 1) return;

    const prevArrow = carousel.querySelector('.pdp-reviews-carousel__arrow--prev');
    const nextArrow = carousel.querySelector('.pdp-reviews-carousel__arrow--next');

    let currentIndex = 0;
    let autoRotateInterval = null;
    const interval = 3000; // 3 seconds

    function showReview(index) {
      currentIndex = (index + items.length) % items.length;
      items.forEach((item, i) => {
        item.classList.toggle('pdp-review-item--active', i === currentIndex);
      });
    }

    function nextReview() {
      showReview(currentIndex + 1);
    }

    function prevReview() {
      showReview(currentIndex - 1);
    }

    function startAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
      }
      autoRotateInterval = setInterval(nextReview, interval);
    }

    function stopAutoRotate() {
      if (autoRotateInterval) {
        clearInterval(autoRotateInterval);
        autoRotateInterval = null;
      }
    }

    if (prevArrow) {
      prevArrow.addEventListener('click', function() {
        prevReview();
        stopAutoRotate();
        startAutoRotate();
      });
    }

    if (nextArrow) {
      nextArrow.addEventListener('click', function() {
        nextReview();
        stopAutoRotate();
        startAutoRotate();
      });
    }

    // Start auto-rotation
    startAutoRotate();

    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoRotate);
    carousel.addEventListener('mouseleave', startAutoRotate);
  })();
</script>

{% schema %}
{
  "name": "PDP Reviews Carousel",
  "tag": null,
  "settings": []
}
{% endschema %}
