            },
            {
              "type": "dropdown_item",
              "settings": {
                "title": "Safe Formulations",
                "content": "<p>Developed with safety in mind, so you can use it around food and family with confidence.</p>"
              }
            },
            {
              "type": "dropdown_item",
              "settings": {
