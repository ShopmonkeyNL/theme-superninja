    { "type": "range", "id": "text_font_size_mobile", "label": "Text size mobile", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "text_line_height_desktop", "label": "Text line-height desktop", "min": 0.8, "max": 2.5, "step": 0.1, "default": 1.0 },
    { "type": "range", "id": "text_line_height_mobile", "label": "Text line-height mobile", "min": 0.8, "max": 2.5, "step": 0.1, "default": 1.0 },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Text weight",
      "options": [
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_text_align",
      "label": "Text align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Features column" },
    { "type": "text", "id": "features_title", "label": "Features title", "default": "FEATURES" },
    { "type": "text", "id": "feature_1", "label": "Feature line 1", "default": "EFFECTIVENESS" },
    { "type": "text", "id": "feature_2", "label": "Feature line 2", "default": "EFFORT REQUIRED" },
