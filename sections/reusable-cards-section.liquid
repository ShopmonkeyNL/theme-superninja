{% comment %}
  Cards with text - reusable numbered cards with image, title, text and auto number.
{% endcomment %}

{% liquid
  assign section_bg = section.settings.background_color | default: '#F0F2F1'
  assign section_padding_top = section.settings.padding_top | default: 48
  assign section_padding_bottom = section.settings.padding_bottom | default: 96
  assign section_padding_top_mobile = section.settings.padding_top_mobile | default: 32
  assign section_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 64
  assign card_blocks = section.blocks | where: 'type', 'numbered_card'
  assign cards_swiper_ref = 'reusableCardsSwiper-' | append: section.id

  if template.name == 'product' and template.suffix == 'v2'
    assign swiper_arrow_asset = 'arrow-right.svg'
  else
    assign swiper_arrow_asset = 'Capa_1.svg'
  endif
%}

<section
  id="simple-to-use"
  class="reusable-cards-section reusable-cards-section--{{ section.id }}"
  style="--rcs-bg: {{ section_bg }}; --rcs-padding-top: {{ section_padding_top }}px; --rcs-padding-bottom: {{ section_padding_bottom }}px; --rcs-padding-top-mobile: {{ section_padding_top_mobile }}px; --rcs-padding-bottom-mobile: {{ section_padding_bottom_mobile }}px;"
  {{ section.shopify_attributes }}
>
  <div class="reusable-cards-section__inner">
    <div class="reusable-cards-section__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% liquid
              assign tag = block.settings.tag | default: 'h2'
              assign fs_d = block.settings.font_size_desktop | default: 64
              assign fs_m = block.settings.font_size_mobile | default: 40
              assign lh_d = block.settings.line_height_desktop | default: 1.2
              assign lh_m = block.settings.line_height_mobile | default: 1.3
              assign fw = block.settings.font_weight | default: '700'
              assign align = block.settings.text_align | default: 'center'
            %}
            <{{ tag }}
              class="reusable-cards-section__heading"
              style="--rcs-fs-d: {{ fs_d }}px; --rcs-fs-m: {{ fs_m }}px; --rcs-lh-d: {{ lh_d }}; --rcs-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.content }}
            </{{ tag }}>

          {% when 'text' %}
            {% liquid
              assign fs_d = block.settings.font_size_desktop | default: 18
              assign fs_m = block.settings.font_size_mobile | default: 16
              assign lh_d = block.settings.line_height_desktop | default: 1.5
              assign lh_m = block.settings.line_height_mobile | default: 1.5
              assign fw = block.settings.font_weight | default: '400'
              assign align = block.settings.text_align | default: 'center'
            %}
            <div
              class="reusable-cards-section__text rte"
              style="--rcs-text-fs-d: {{ fs_d }}px; --rcs-text-fs-m: {{ fs_m }}px; --rcs-text-lh-d: {{ lh_d }}; --rcs-text-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.content }}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    {% if card_blocks.size > 0 %}
      {% capture reusable_cards_swiper_slides %}
        {% for block in card_blocks %}
          <div class="swiper-slide resource-list-swiper__slide">
            {% render 'reusable-cards-section-card', block: block, index: forloop.index %}
          </div>
        {% endfor %}
      {% endcapture %}

      <div class="reusable-cards-section__cards-swiper">
        {% render 'resource-list-swiper',
          ref: cards_swiper_ref,
          slides: card_blocks,
          slides_markup: reusable_cards_swiper_slides,
          slide_count: card_blocks.size,
          settings: section.settings,
          slide_width_max: '313px'
        %}
      </div>

      <div class="reusable-cards-section__cards reusable-cards-section__cards-static">
        {% for block in card_blocks %}
          {% render 'reusable-cards-section-card', block: block, index: forloop.index, include_shopify_attributes: true %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .reusable-cards-section {
    padding: var(--rcs-padding-top, 48px) 16px var(--rcs-padding-bottom, 96px);
    background: var(--rcs-bg);
  }

  .reusable-cards-section__inner {
    max-width: 1312px;
    margin: 0 auto;
  }

  .reusable-cards-section__content {
    margin-bottom: 40px;
  }

  .reusable-cards-section__heading {
    margin: 0;
    color: #1C1C1C;
    font-family: var(--font-heading--family);
    font-size: var(--rcs-fs-d, 64px);
    line-height: var(--rcs-lh-d, 1.2);
    font-weight: 700;
    text-transform: uppercase;
  }

  .reusable-cards-section__heading p {
    margin: 0;
  }

  .reusable-cards-section__text {
    margin: 12px 0 0;
    font-size: var(--rcs-text-fs-d, 18px);
    line-height: var(--rcs-text-lh-d, 1.5);
    color: #1C1C1C;
  }

  .reusable-cards-section__text p {
    margin: 0;
  }

  .reusable-cards-section__cards {
    display: flex;
    flex-wrap: nowrap;
    gap: 24px;
    justify-content: center;
    align-items: stretch;
  }

  .reusable-cards-section__cards-swiper {
    display: none;
  }

  .reusable-cards-section__cards-swiper .resource-list-swiper__slide {
    height: auto;
  }

  .reusable-cards-section__cards-swiper .reusable-cards-section__card {
    max-width: 100%;
  }

  .reusable-cards-section--{{ section.id }} .resource-list-swiper-container {
    --swiper-navigation-width: 36px;
    --swiper-navigation-height: 36px;
  }

  .reusable-cards-section--{{ section.id }} .resource-list-swiper__nav {
    width: 36px;
    height: 36px;
    background: #fff;
    border: none;
    border-radius: 100%;
    box-shadow: 0 1px 5px 0 rgb(0 0 0 / 7%);
    padding: 0;
    transition: opacity 0.2s ease;
  }

  .reusable-cards-section--{{ section.id }} .resource-list-swiper__nav:hover {
    opacity: 0.9;
  }

  .reusable-cards-section--{{ section.id }} .resource-list-swiper__arrow {
    font-size: 0;
    line-height: 0;
    color: transparent;
  }

  .reusable-cards-section--{{ section.id }} .resource-list-swiper__arrow::before {
    content: '';
    width: 36px;
    height: 36px;
    display: block;
    background-image: url('{{ swiper_arrow_asset | asset_url }}');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
  }

  .reusable-cards-section--{{ section.id }} .swiper-button-prev .resource-list-swiper__arrow::before {
    transform: rotate(180deg);
  }

  @media screen and (max-width: 1199px) {
    .reusable-cards-section__cards-swiper {
      display: block;
    }

    .reusable-cards-section__cards-static {
      display: none;
    }
  }

  .reusable-cards-section__card {
    background: #F0F2F1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0!important;
    max-width: 313px;
    width: 100%;
  }

  .reusable-cards-section__card-image-wrapper {
    max-width: 200px;
    height: 180px;
    border: none;
    background: transparent;
    overflow: hidden;
    margin: 0;
    position:relative;
    top:20px;
  }

  .reusable-cards-section__card-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .reusable-cards-section__card-body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 12px 12px;
    background: #fff;
    width: 100%;
  }

  .reusable-cards-section__card-copy {
    flex: 1;
    min-width: 0;
  }

  .reusable-cards-section__card-title {
    margin: 0;
    color: #1C1C1C;
    font-family: var(--font-heading--family);
    text-transform: uppercase;
  }

  .reusable-cards-section__card-text {
    margin: 10px 0 0;
    color: #4A4A4A;
  }

  .reusable-cards-section__card-text p {
    margin: 0;
  }

  .reusable-cards-section__card-number {
    color: #FF5000;
    font-family: var(--font-heading--family);
    font-size: 126px;
    line-height: 1;
    font-weight: 700;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  @media screen and (max-width: 1024px) {
    .reusable-cards-section__cards {
    flex-wrap: wrap;
  }
  }

  @media screen and (max-width: 768px) {
    .reusable-cards-section {
      padding-top: var(--rcs-padding-top-mobile, 32px);
      padding-bottom: var(--rcs-padding-bottom-mobile, 64px);
    }

    .reusable-cards-section__heading {
      font-size: var(--rcs-fs-m, 40px) !important;
      line-height: var(--rcs-lh-m, 1.3) !important;
    }

    .reusable-cards-section__text {
      font-size: var(--rcs-text-fs-m, 16px) !important;
      line-height: var(--rcs-text-lh-m, 1.5) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Cards with text",
  "tag": "section",
  "class": "section-reusable-cards",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F0F2F1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Carousel layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Slides per view (desktop)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_columns_carousel",
      "label": "Slides per view (mobile)",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Slide gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show arrows (mobile)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots (desktop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots_mobile",
      "label": "Show dots (mobile)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_timeout",
      "label": "Autoplay timeout",
      "min": 1000,
      "max": 9900,
      "step": 100,
      "unit": "ms",
      "default": 2500,
      "visible_if": "{{ section.settings.autoplay == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "info": "Optional. e.g. simple-to-use — used for in-page links (e.g. footer « How It Works » on PDP)."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "Content",
          "default": "HOW TO USE"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "p", "label": "P" },
            { "value": "span", "label": "Span" }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "font_size_desktop",
          "label": "Font size (desktop)",
          "min": 12,
          "max": 72,
          "step": 1,
          "unit": "px",
          "default": 64
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Font size (mobile)",
          "min": 12,
          "max": 48,
          "step": 1,
          "unit": "px",
          "default": 40
        },
        {
          "type": "range",
          "id": "line_height_desktop",
          "label": "Line height (desktop)",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.2
        },
        {
          "type": "range",
          "id": "line_height_mobile",
          "label": "Line height (mobile)",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.3
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" }
          ],
          "default": "700"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Follow these quick steps.</p>"
        },
        {
          "type": "range",
          "id": "font_size_desktop",
          "label": "Font size (desktop)",
          "min": 12,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 18
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Font size (mobile)",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "line_height_desktop",
          "label": "Line height (desktop)",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.5
        },
        {
          "type": "range",
          "id": "line_height_mobile",
          "label": "Line height (mobile)",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.5
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" }
          ],
          "default": "400"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "numbered_card",
      "name": "Numbered card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Shopify)"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Asset image (filename)",
          "info": "Use filename from assets folder if no Shopify image is selected."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Remove"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Remove the source or smell - either the fruits or trash.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cards with text",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "content": "HOW TO USE"
          }
        },
        {
          "type": "text",
          "settings": {
            "content": "<p>Follow these quick steps.</p>"
          }
        },
        {
          "type": "numbered_card",
          "settings": {
            "asset_image": "Rectangle 16-1.png",
            "title": "Remove",
            "content": "<p>Remove the source or smell - either the fruits or trash.</p>"
          }
        },
        {
          "type": "numbered_card",
          "settings": {
