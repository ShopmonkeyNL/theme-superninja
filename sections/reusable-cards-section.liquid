            "title": "shake",
            "content": "<p>Shake the bottle for a consistent mixage.</p>"
          }
        },
        {
          "type": "numbered_card",
          "settings": {
            "asset_image": "Rectangle 17.png",
            "title": "Open",
            "content": "<p>Shake the bottle for a consistent mixage.</p>"
          }
        },
        {
          "type": "numbered_card",
          "settings": {
            "asset_image": "Rectangle 18.png",
            "title": "Clean",
            "content": "<p>Clean the excess liquid from the yellow funnel.</p>"
          }
        },
        {
          "type": "numbered_card",
          "settings": {
            "asset_image": "Rectangle 19.png",
            "title": "place & go",
            "content": "<p>Place it near your<br>fruits and let it<br>work its magic.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
