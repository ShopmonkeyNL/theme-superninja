                </svg>
              </div>

              <h3 class="about-proof-carousel__card-title">{{ block.settings.title }}</h3>
              <p class="about-proof-carousel__card-text">{{ block.settings.text }}</p>
              <p class="about-proof-carousel__card-name">{{ block.settings.name }}</p>
            </article>
          {% endfor %}
        </div>
      </div>

      <button type="button" class="about-proof-carousel__arrow about-proof-carousel__arrow--next" data-apc-next aria-label="{{ section.settings.next_label | escape }}">
        <img src="{{ 'arrow-right.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">
      </button>
    </div>
  </div>
</section>

<style>
  .about-proof-carousel {
    background: var(--apc-bg);
    padding: var(--apc-pt) 16px var(--apc-pb);
    overflow: hidden;
  }

  .about-proof-carousel__inner {
    max-width: 1312px;
    margin: 0 auto;
  }

  .about-proof-carousel__trust {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .about-proof-carousel__top-stars {
    line-height: 0;
  }

  .about-proof-carousel__trust-text {
    font-family: Tahoma, sans-serif;
    font-weight: 400;
    font-size: var(--apc-trust-fs-d);
    line-height: 1;
    letter-spacing: 0;
    color: #2D2D2D;
  }

  .about-proof-carousel__trust-text p {
    margin: 0;
  }

  .about-proof-carousel__heading {
    margin: 0 0 40px;
    text-align: center;
    text-transform: uppercase;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style, normal);
    font-weight: 700;
    font-size: var(--apc-heading-fs-d);
    line-height: 1;
    letter-spacing: 0;
    color: #1C1C1C;
  }

  .about-proof-carousel__carousel-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-proof-carousel__arrow {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    line-height: 0;
    transition: opacity .2s ease;
  }

  .about-proof-carousel__arrow img {
    display: block;
    width: 56px;
    height: 56px;
  }

  .about-proof-carousel__arrow[disabled] {
    opacity: .35;
    cursor: not-allowed;
  }

  .about-proof-carousel__viewport {
    overflow: hidden;
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .about-proof-carousel__track {
    display: flex;
    gap: var(--apc-gap);
    transition: transform .35s ease;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .about-proof-carousel__card {
    width: 100%;
    max-width: var(--apc-card-max-w-desktop);
    flex: 0 0 min(var(--apc-card-max-w-desktop), calc((100% - (2 * var(--apc-gap))) / 3));
    min-width: 0;
    background: var(--apc-card-bg);
    padding: var(--apc-card-padding);
    border-radius: var(--apc-radius);
    box-sizing: border-box;
  }

  .about-proof-carousel__card-stars {
    margin-bottom: 24px;
    line-height: 0;
  }

  .about-proof-carousel__card-title {
    margin: 0 0 12px;
    text-transform: uppercase;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style, normal);
    font-weight: 700;
    font-size: var(--apc-card-title-fs);
    line-height: 1;
    letter-spacing: 0;
    color: #1C1C1C;
  }

  .about-proof-carousel__card-text {
    margin: 0 0 24px;
    font-family: Tahoma, sans-serif;
    font-weight: 400;
    font-size: var(--apc-card-text-fs);
    line-height: 1.5;
    letter-spacing: 0;
    color: #1C1C1C;
  }

  .about-proof-carousel__card-name {
    margin: 0;
    text-transform: uppercase;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style, normal);
    font-weight: 700;
    font-size: var(--apc-card-name-fs);
    line-height: 1;
    letter-spacing: 0;
    color: #1C1C1C;
  }

  @media (max-width: 768px) {
    .about-proof-carousel {
      padding-left: 8px;
      padding-right: 8px;
    }

    .about-proof-carousel__carousel-wrap {
      gap: 8px;
    }

    .about-proof-carousel__arrow img {
      width: 44px;
      height: 44px;
    }

    .about-proof-carousel__trust {
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: nowrap;
    }

    .about-proof-carousel__top-stars svg {
      width: 86px;
      height: auto;
    }

    .about-proof-carousel__trust-text {
      font-size: var(--apc-trust-fs-m);
    }

    .about-proof-carousel__heading {
      margin-bottom: 24px;
      font-size: var(--apc-heading-fs-m);
    }

    .about-proof-carousel__viewport {
      overflow: visible;
    }

    .about-proof-carousel__card {
      width: 100%;
      flex: 0 0 min(100%, var(--apc-card-max-w-mobile));
      max-width: var(--apc-card-max-w-mobile);
    }

    .about-proof-carousel__card-title {
      font-size: 16px;
    }

    .about-proof-carousel__card-text {
      font-size: 14px;
    }

    .about-proof-carousel__card-name {
      font-size: 16px;
    }
  }
</style>

<script>
  (function () {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const root = sectionEl.querySelector('[data-apc-root]');
    const viewport = sectionEl.querySelector('[data-apc-viewport]');
    const track = sectionEl.querySelector('[data-apc-track]');
    const prevBtn = sectionEl.querySelector('[data-apc-prev]');
    const nextBtn = sectionEl.querySelector('[data-apc-next]');
    if (!root || !viewport || !track || !prevBtn || !nextBtn) return;

    let index = 0;
    let maxIndex = 0;
    let perView = 3;
    let startX = 0;
    let endX = 0;

    const cards = () => Array.from(track.children);

    const getGap = () => {
      const styles = window.getComputedStyle(track);
      return parseFloat(styles.columnGap || styles.gap || '0');
    };

    const getPerView = () => {
      if (window.matchMedia('(max-width: 768px)').matches) return 1;
      const configured = parseInt(root.dataset.desktopPerView || '3', 10);
      return Math.max(1, Math.min(4, configured));
    };

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    const update = () => {
      const allCards = cards();
      if (!allCards.length) return;
      perView = getPerView();
      maxIndex = Math.max(0, allCards.length - perView);
      index = clamp(index, 0, maxIndex);

      const first = allCards[0];
      const step = first.getBoundingClientRect().width + getGap();
      track.style.transform = `translate3d(${-index * step}px, 0, 0)`;

      prevBtn.disabled = index <= 0;
      nextBtn.disabled = index >= maxIndex;
    };

    prevBtn.addEventListener('click', () => {
      index = clamp(index - 1, 0, maxIndex);
      update();
    });

    nextBtn.addEventListener('click', () => {
      index = clamp(index + 1, 0, maxIndex);
      update();
    });

    viewport.addEventListener('touchstart', (event) => {
      startX = event.changedTouches[0].clientX;
    }, { passive: true });

    viewport.addEventListener('touchend', (event) => {
      endX = event.changedTouches[0].clientX;
      const delta = endX - startX;
      if (Math.abs(delta) < 30) return;
      if (delta < 0) {
        index = clamp(index + 1, 0, maxIndex);
      } else {
        index = clamp(index - 1, 0, maxIndex);
      }
      update();
    }, { passive: true });

    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "About - Proof Carousel",
  "tag": "section",
  "class": "section-about-proof-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "trust_text",
      "label": "Top trust text",
      "default": "<p>Trusted by <strong>1000+</strong> Happy Customers</p>"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "It Worked for Them. It'll Work for You."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "desktop_cards_per_view",
      "label": "Cards per view (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_max_width_desktop",
      "label": "Card max width (desktop)",
      "min": 320,
      "max": 560,
      "step": 8,
      "unit": "px",
      "default": 424
    },
