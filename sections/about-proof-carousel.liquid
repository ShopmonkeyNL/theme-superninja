          <path d="M65.3057 0.843656C65.0648 0.328088 64.5558 0 63.9967 0C63.4377 0 62.9332 0.328088 62.6878 0.843656L59.7654 7.04452L53.2388 8.03816C52.6934 8.12253 52.2389 8.51623 52.0707 9.05524C51.9026 9.59424 52.0389 10.1895 52.4298 10.5879L57.1656 15.4201L56.0476 22.2491C55.9567 22.8115 56.1839 23.3833 56.6339 23.7161C57.0838 24.0489 57.6792 24.0911 58.1701 23.8239L64.0013 20.6133L69.8325 23.8239C70.3233 24.0911 70.9187 24.0536 71.3687 23.7161C71.8186 23.3786 72.0459 22.8115 71.955 22.2491L70.8324 15.4201L75.5682 10.5879C75.9591 10.1895 76.1 9.59424 75.9273 9.05524C75.7546 8.51623 75.3046 8.12253 74.7592 8.03816L68.2281 7.04452L65.3057 0.843656Z" fill="var(--apc-star)"/>
