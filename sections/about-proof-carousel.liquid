        </svg>
      </div>
      <div class="about-proof-carousel__trust-text rte">{{ trust_text }}</div>
    </div>

    <h2 class="about-proof-carousel__heading">{{ heading }}</h2>

    <div class="about-proof-carousel__carousel-wrap">
      <button type="button" class="about-proof-carousel__arrow about-proof-carousel__arrow--prev" data-apc-prev aria-label="{{ section.settings.prev_label | escape }}">
        <img src="{{ 'arrow-left.svg' | asset_url }}" alt="" width="56" height="56" loading="lazy">
      </button>

      <div class="about-proof-carousel__viewport" data-apc-viewport>
        <div class="about-proof-carousel__track" data-apc-track>
          {% for block in section.blocks %}
            {% if block.type != 'testimonial' %}
              {% continue %}
            {% endif %}
            <article class="about-proof-carousel__card" {{ block.shopify_attributes }}>
              <div class="about-proof-carousel__card-stars" aria-hidden="true">
                <svg width="120" height="24" viewBox="0 0 120 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.1033 1.81699C11.4701 1.07374 12.5299 1.07374 12.8967 1.81699L15.294 6.67446C15.4397 6.9696 15.7213 7.17417 16.047 7.2215L21.4075 8.00043C22.2277 8.11961 22.5552 9.12759 21.9617 9.70612L18.0828 13.4871C17.8471 13.7169 17.7396 14.0479 17.7952 14.3723L18.7109 19.7111C18.851 20.528 17.9936 21.151 17.26 20.7653L12.4653 18.2446C12.174 18.0915 11.826 18.0915 11.5347 18.2446L6.74005 20.7653C6.00642 21.151 5.14899 20.528 5.2891 19.7111L6.20479 14.3723C6.26043 14.0479 6.15288 13.7169 5.91719 13.4871L2.03827 9.70612C1.44476 9.12759 1.77226 8.11961 2.59249 8.00043L7.95302 7.2215C8.27873 7.17417 8.5603 6.9696 8.70596 6.67446L11.1033 1.81699Z" fill="var(--apc-star)"/>
