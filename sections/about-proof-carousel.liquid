                  <path d="M59.1033 1.81699C59.4701 1.07374 60.5299 1.07374 60.8967 1.81699L63.294 6.67446C63.4397 6.9696 63.7213 7.17417 64.047 7.2215L69.4075 8.00043C70.2277 8.11961 70.5552 9.12759 69.9617 9.70612L66.0828 13.4871C65.8471 13.7169 65.7396 14.0479 65.7952 14.3723L66.7109 19.7111C66.851 20.528 65.9936 21.151 65.26 20.7653L60.4653 18.2446C60.174 18.0915 59.826 18.0915 59.5347 18.2446L54.7401 20.7653C54.0064 21.151 53.149 20.528 53.2891 19.7111L54.2048 14.3723C54.2604 14.0479 54.1529 13.7169 53.9172 13.4871L50.0383 9.70612C49.4448 9.12759 49.7723 8.11961 50.5925 8.00043L55.953 7.2215C56.2787 7.17417 56.5603 6.9696 56.706 6.67446L59.1033 1.81699Z" fill="var(--apc-star)"/>
