{% comment %}
  About page social proof carousel.
  - Top trust row: star icons + rich text
  - Main title
  - Testimonial cards in carousel
  - Desktop: 3 cards per view
  - Mobile: 1 card centered with side peeks
{% endcomment %}

{% liquid
  assign section_bg = section.settings.section_bg_color | default: '#F0F2F1'
  assign card_bg = section.settings.card_bg_color | default: '#E7E7E7'
  assign heading = section.settings.heading | default: "It Worked for Them. It'll Work for You."
  assign trust_text = section.settings.trust_text | default: '<p>Trusted by <strong>1000+</strong> Happy Customers</p>'
%}

<section
  class="about-proof-carousel"
  style="
    --apc-bg: {{ section_bg }};
    --apc-card-bg: {{ card_bg }};
    --apc-pt: {{ section.settings.padding_top | default: 70 }}px;
    --apc-pb: {{ section.settings.padding_bottom | default: 90 }}px;
    --apc-trust-fs-d: {{ section.settings.trust_font_size_desktop | default: 16 }}px;
    --apc-trust-fs-m: {{ section.settings.trust_font_size_mobile | default: 12 }}px;
    --apc-heading-fs-d: {{ section.settings.heading_font_size_desktop | default: 64 }}px;
    --apc-heading-fs-m: {{ section.settings.heading_font_size_mobile | default: 40 }}px;
    --apc-card-title-fs: {{ section.settings.card_title_font_size | default: 22 }}px;
    --apc-card-text-fs: {{ section.settings.card_text_font_size | default: 18 }}px;
    --apc-card-name-fs: {{ section.settings.card_name_font_size | default: 24 }}px;
    --apc-card-padding: {{ section.settings.card_padding | default: 24 }}px;
    --apc-gap: {{ section.settings.card_gap | default: 16 }}px;
    --apc-radius: {{ section.settings.card_border_radius | default: 0 }}px;
    --apc-card-max-w-desktop: {{ section.settings.card_max_width_desktop | default: 424 }}px;
    --apc-card-max-w-mobile: {{ section.settings.card_max_width_mobile | default: 288 }}px;
    --apc-star: {{ section.settings.star_color | default: '#FF5000' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="about-proof-carousel__inner" data-apc-root data-desktop-per-view="{{ section.settings.desktop_cards_per_view | default: 3 }}">
    <div class="about-proof-carousel__trust">
      <div class="about-proof-carousel__top-stars" aria-hidden="true">
        <svg width="128" height="24" viewBox="0 0 128 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M13.3057 0.843656C13.0648 0.328088 12.5558 0 11.9967 0C11.4377 0 10.9332 0.328088 10.6878 0.843656L7.76537 7.04452L1.2388 8.03816C0.693401 8.12253 0.238904 8.51623 0.0707399 9.05524C-0.0974239 9.59424 0.0389251 10.1895 0.429792 10.5879L5.16565 15.4201L4.04759 22.2491C3.95669 22.8115 4.18394 23.3833 4.63389 23.7161C5.08384 24.0489 5.67923 24.0911 6.17009 23.8239L12.0013 20.6133L17.8325 23.8239C18.3233 24.0911 18.9187 24.0536 19.3687 23.7161C19.8186 23.3786 20.0459 22.8115 19.955 22.2491L18.8324 15.4201L23.5682 10.5879C23.9591 10.1895 24.1 9.59424 23.9273 9.05524C23.7546 8.51623 23.3046 8.12253 22.7592 8.03816L16.2281 7.04452L13.3057 0.843656Z" fill="var(--apc-star)"/>
