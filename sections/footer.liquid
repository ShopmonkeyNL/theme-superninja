{% comment %}
  Custom Footer – Simple footer with logo and customizable columns.
{% endcomment %}

{% liquid
  assign bg_color = section.settings.background_color | default: '#F0F2F1'
  assign column_blocks = section.blocks | where: 'type', 'column'
  assign footer_bg_image = section.settings.footer_bg_image
  if footer_bg_image != blank
    assign footer_bg_url = footer_bg_image | image_url: width: 1920
  else
    assign footer_bg_url = 'footer-bg.png' | asset_url
  endif
%}

<footer class="custom-footer custom-footer--{{ section.id }}" style="--cf-bg: {{ bg_color }};" {{ section.shopify_attributes }}>
  <div class="custom-footer__inner">
    <div class="custom-footer__logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        <img src="{{ 'Logo_Super_Ninja_2025 2.svg' | asset_url }}" alt="{{ shop.name }}" loading="lazy" width="314" height="96">
      </a>
    </div>
    <div class="custom-footer__columns">
      {% for block in column_blocks %}
        <div class="custom-footer__column" {{ block.shopify_attributes }}>
          <h3 class="custom-footer__column-title">{{ block.settings.title }}</h3>
          <ul class="custom-footer__column-items">
            {% for i in (1..10) %}
              {% liquid
                assign link_text_key = 'link_text_' | append: i
                assign link_url_key = 'link_url_' | append: i
                assign link_text = block.settings[link_text_key]
                assign link_url = block.settings[link_url_key]
                assign is_how_it_works = false
                if link_text != blank and link_url != blank
                  assign link_text_down = link_text | downcase
                  if link_text_down contains 'how it works' or link_url == '/pages/how-it-works'
                    assign is_how_it_works = true
                  endif
                endif
              %}
              {% if is_how_it_works %}
                {% comment %} Show "How It Works" only on product pages: scroll to #simple-to-use on current PDP {% endcomment %}
                {% if request.page_type == 'product' %}
                  <li class="custom-footer__column-item">
                    <a href="#simple-to-use">{{ link_text }}</a>
                  </li>
                {% endif %}
              {% elsif link_text != blank %}
                <li class="custom-footer__column-item">
                  {% if link_url != blank %}
                    <a href="{{ link_url }}">{{ link_text }}</a>
                  {% else %}
                    <span>{{ link_text }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="custom-footer__bottom" style="background-image: url({{ footer_bg_url }});">
    <div class="custom-footer__bottom-inner">
      <div class="custom-footer__copyright">
        © {{ 'now' | date: '%Y' }} Super Ninja. All rights reserved.
      </div>
      <div class="custom-footer__legal">
        {% if section.settings.terms_url != blank %}
          <a href="{{ section.settings.terms_url }}">Terms of Service</a>
        {% else %}
          <span>Terms of Service</span>
        {% endif %}
        {% if section.settings.privacy_url != blank %}
          <a href="{{ section.settings.privacy_url }}">Privacy Policy</a>
        {% else %}
          <span>Privacy Policy</span>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

<style>
  .custom-footer {
    background: var(--cf-bg);
    padding-top: 48px;
  }

  .custom-footer__inner {
    max-width: 1312px;
    margin: 0 auto;
    display: flex;
    gap: 4rem;
    align-items: center;
    justify-content: space-between;
  }

  .custom-footer__logo {
    flex-shrink: 0;
  }

  .custom-footer__logo a {
    display: block;
    text-decoration: none;
  }

  .custom-footer__logo img {
    display: block;
    height: auto;
    max-width: 304px;
  }

  .custom-footer__columns {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    flex: 1;
    justify-content: flex-end;
  }

  .custom-footer__column {
    min-width: 150px;
  }

  .custom-footer__column-title {
    margin: 0 0 1rem;
    font-size: 24px;
    font-weight: 700;
    color: #FF5000;
    text-transform: uppercase;
    font-family: var(--font-heading--family);
  }

  .custom-footer__column-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .custom-footer__column-item {
    margin: 0;
  }

  .custom-footer__column-item a,
  .custom-footer__column-item span {
    font-size: 16px;
    color: #1C1C1C;
    text-decoration: none;
    display: block;
    transition: opacity 0.2s ease;
  }

  .custom-footer__column-item a:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .custom-footer__inner {
      flex-direction: column-reverse;
      gap: 2rem;
    padding: 0 16px;

    }

    .custom-footer__columns {
      width: 100%;
      gap: 2rem;
    }

    .custom-footer__column {
      min-width: auto;
      flex: 1;
      min-width: 150px;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-footer {
      padding: 48px 0 0 0;
    }

    .custom-footer__columns {
      flex-direction: row;
      gap: 40px;
    }

    .custom-footer__column {
      width: 100%;
    }
  }

  /* Footer bottom - Copyright and Legal */
  .custom-footer__bottom {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 48px 16px;
    margin-top: 48px;

  }

  .custom-footer__bottom-inner {
    max-width: 1312px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .custom-footer__copyright {
    font-size: 14px;
    color: #fff;   
  }

  .custom-footer__legal {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .custom-footer__legal a,
  .custom-footer__legal span {
    font-size: 14px;
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .custom-footer__legal a:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .custom-footer__bottom {
      padding: 48px 16px 48px 16px;
    }

    .custom-footer__bottom-inner {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .custom-footer__legal {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

