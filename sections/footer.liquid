<div
  class='section section--page-width'
  {{ section.shopify_attributes }}
>
  <div class='footer-inner'>
    <div class='footer-inner__about'>
      <img
        src='{{ settings.logo | image_url }}'
        alt='Super Ninja black and white logo'
      >
      {% if section.settings.super_ninja_description %}
        <div class='about-text'>{{ section.settings.super_ninja_description }}</div>
      {% endif %}
    </div>
    <div class='footer-inner__columns'>
      {% for block in section.blocks %}
        <div class="footer-column">
          <h5>{{ block.settings.link_list.title }}</h5>
          {% if block.settings.link_list.links %}
            <div class="footer-column__items">
              {% for link in block.settings.link_list.links %}
                <a href="{{ link.url }}" class="item">{{ link.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  footer .footer-inner {
    padding-block: 2rem;
    display: grid;
    gap: 2rem;

    & .footer-inner__about {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;

      & img {
        max-width: 350px;
      }
    }

    & .footer-inner__columns {
      display: flex;
      flex-direction: column;
      justify-content: end;
      gap: 2rem;

      & .footer-column {
        & h5 {
          margin-block-end: 0.75rem;
          
          @media (min-width: 768px) {
            margin-block-end: 1.5rem;
          }
        }

        & .footer-column__items {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;

          & .item {
            transition: opacity 0.2s ease-out;
            
            &:hover {
              transition: opacity 0.2s ease-out;
              opacity: 0.6;
            }
          }
        }
      }

      @media (min-width: 750px) {
        flex-direction: row;
        gap: 8rem;
      }
    }

    @media (min-width: 750px) {
      grid-template-columns: 0.5fr 1fr;
      gap: 4rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section-footer",
  "blocks": [
    {
      "type": "heading",
      "name": "Column",
      "settings": [
        {
          "type": "link_list",
          "id": "link_list",
          "label": "Menu",
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "richtext",
      "id": "super_ninja_description",
      "label": "Super Ninja description",
      "default": "<p>Bij Super Ninja ontwikkelen we duurzame en gifvrije oplossingen voor ongediertebestrijding. Met innovatieve producten, zoals de Fruit Fly Ninja, bieden we een effectieve en milieuvriendelijke manier om fruitvliegjes en ander ongedierte te bestrijden. </p>"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
