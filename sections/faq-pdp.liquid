{% liquid
  assign section_bg = section.settings.background_color | default: '#F0F2F1'
  assign border_color = section.settings.border_color | default: '#FF5000'
  assign icon_color = section.settings.icon_color | default: '#FF5000'
  assign title_color = section.settings.title_color | default: '#1C1C1C'
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
%}

<section
  id="faq"
  class="faq-pdp faq-pdp--{{ section.id }}"
  style="--faq-bg: {{ section_bg }}; --faq-border-color: {{ border_color }}; --faq-icon-color: {{ icon_color }}; --faq-title-color: {{ title_color }};"
  {{ section.shopify_attributes }}
>
  <div class="faq-pdp__inner">
    <div class="faq-pdp__main">
      <div class="faq-pdp__heading-wrap">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'faq_heading' %}
              {% liquid
                assign tag = block.settings.tag | default: 'h2'
                assign fs_d = block.settings.font_size_desktop | default: 64
                assign fs_m = block.settings.font_size_mobile | default: 40
                assign lh_d = block.settings.line_height_desktop | default: 1.2
                assign lh_m = block.settings.line_height_mobile | default: 1.3
                assign fw = block.settings.font_weight | default: '700'
                assign align = block.settings.text_align | default: 'left'
              %}
              <{{ tag }}
                class="faq-pdp__heading"
                style="--faq-heading-fs-d: {{ fs_d }}px; --faq-heading-fs-m: {{ fs_m }}px; --faq-heading-lh-d: {{ lh_d }}; --faq-heading-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.content }}
              </{{ tag }}>
          {% endcase %}
        {% endfor %}
      </div>

      <div class="faq-pdp__accordion">
        {% for block in faq_blocks %}
          <details class="faq-pdp__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq-pdp__trigger">
              <span class="faq-pdp__question">{{ block.settings.question }}</span>
              <span class="faq-pdp__icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip0_324_3492_{{ section.id }}_{{ forloop.index0 }})">
                    <path d="M12 0C5.37262 0 0 5.37262 0 12C0 18.6274 5.37262 24 12 24C18.6274 24 24 18.6274 24 12C24 5.37262 18.6274 0 12 0ZM12 21.6C6.70655 21.6 2.4 17.2935 2.4 12C2.4 6.70655 6.70655 2.4 12 2.4C17.293 2.4 21.6 6.70655 21.6 12C21.6 17.2935 17.293 21.6 12 21.6Z" fill="var(--faq-icon-color, #FF5000)"/>
                    <path d="M12 21.6C6.70655 21.6 2.4 17.2935 2.4 12C2.4 6.70655 6.70655 2.4 12 2.4C17.293 2.4 21.6 6.70655 21.6 12C21.6 17.2935 17.293 21.6 12 21.6Z" fill="var(--faq-icon-color, #FF5000)"/>
                    <path d="M8.85453 10.4061L12.7458 10.4059L8.006 15.1457L9.70306 16.8427L14.4429 12.1029L14.4426 15.9942H16.8429L16.8426 8.00615L8.85453 8.00582L8.85453 10.4061Z" fill="#F0F2F1"/>
                  </g>
                  <defs>
                    <clipPath id="clip0_324_3492_{{ section.id }}_{{ forloop.index0 }}">
                      <rect width="24" height="24" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </span>
            </summary>
            <div class="faq-pdp__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-pdp {
    background: var(--faq-bg);
    padding: 140px 8px 140px 8px;
  }

  .faq-pdp__inner {
    max-width: 1312px;
    margin: 0 auto;
  }

  .faq-pdp__main {
display: flex;

    gap: 28px;
    align-items: center;
  }

  .faq-pdp__heading {
    margin: 0;
    color: var(--faq-title-color, #1C1C1C);
    font-family: var(--font-heading--family);
    font-size: var(--faq-heading-fs-d, 64px);
    line-height: var(--faq-heading-lh-d, 1.2);
    font-weight: 700;
    text-transform: uppercase;
  }

  .faq-pdp__heading p {
    margin: 0;
  }

  .faq-pdp__accordion {
    width: 100%;
    max-width: 757px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-pdp__item {
    border: 1.5px solid rgba(28, 28, 28, 0.2);
    background: #F0F2F1;
  }

  .faq-pdp__item[open] {
    border: 3px solid var(--faq-border-color, #FF5000);
  }

  .faq-pdp__trigger {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px;
    cursor: pointer;
    background: #fff;
  }

  .faq-pdp__trigger::-webkit-details-marker {
    display: none;
  }

  .faq-pdp__question {
    color: var(--faq-title-color, #1C1C1C);
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
    text-transform: uppercase;
  }

  .faq-pdp__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .faq-pdp__item:not([open]) .faq-pdp__icon {
    transform: rotate(90deg);
    opacity: 0.5;
  }

  .faq-pdp__answer {
    padding: 0 24px 24px;
    color: #1C1C1C;
    font-family: Tahoma, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1;
    background: #fff;
  }

  .faq-pdp__answer p {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .faq-pdp__main {
      flex-direction: column;
      gap: 18px;
      justify-content: center;
      align-items: center;
    }

    .faq-pdp__heading {
      font-size: var(--faq-heading-fs-m, 40px) !important;
      line-height: var(--faq-heading-lh-m, 1.3) !important;
      text-align: center !important;
    }

    .faq-pdp__accordion {
      max-width: 100%;
    }

    .faq-pdp__trigger {
      padding: 20px;
    }

    .faq-pdp__question {
      font-size: 20px;
    }

    .faq-pdp__answer {
      padding: 0 20px 20px;
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "FAQ PDP",
  "tag": "section",
  "class": "section-faq-pdp",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F0F2F1"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color (when open)",
      "default": "#FF5000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FF5000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading and question color",
      "default": "#1C1C1C"
    }
  ],
  "blocks": [
    {
      "type": "faq_heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "Content",
          "default": "Frequently Asked Questions"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "p", "label": "P" },
            { "value": "span", "label": "Span" }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "font_size_desktop",
          "label": "Font size (desktop)",
          "min": 12,
          "max": 72,
          "step": 1,
          "unit": "px",
          "default": 64
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Font size (mobile)",
          "min": 12,
          "max": 48,
          "step": 1,
          "unit": "px",
          "default": 40
        },
        {
          "type": "range",
          "id": "line_height_desktop",
          "label": "Line height (desktop)",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.2
        },
        {
          "type": "range",
          "id": "line_height_mobile",
          "label": "Line height (mobile)",
          "min": 0.8,
          "max": 2.5,
          "step": 0.1,
          "default": 1.3
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" }
          ],
          "default": "700"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Will this really work better than DIY?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes! Our formula is scientifically optimized to attract and trap fruit flies more effectively than homemade vinegar solutions. The funnel design prevents escape, and the bait lasts up to 30 days without needing replacement.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ PDP",
      "blocks": [
        {
          "type": "faq_heading",
          "settings": {
            "content": "Frequently Asked Questions"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Will this really work better than DIY?",
            "answer": "<p>Yes! Our formula is scientifically optimized to attract and trap fruit flies more effectively than homemade vinegar solutions. The funnel design prevents escape, and the bait lasts up to 30 days without needing replacement.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How fast will I see results?",
            "answer": "<p>Most customers start seeing visible reductions within the first 24 hours, with stronger results over the next few days.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for pets and kids?",
            "answer": "<p>Super Ninja is designed for everyday home use when used as directed, including homes with pets and children.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does one trap last?",
            "answer": "<p>Each trap is built to provide long-lasting performance, typically up to 30 days before replacement is needed.</p>"
