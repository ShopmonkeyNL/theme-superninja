        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What if it doesn't work for me?",
            "answer": "<p>If results are not as expected, our support team can help optimize placement and usage for your specific environment.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
