    {
      "type": "text",
      "id": "asset_image_desktop",
      "label": "Asset image desktop (filename)",
      "info": "Optional fallback from assets folder when desktop image is not selected."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Main image (mobile)",
      "info": "Default: dropmob.png"
