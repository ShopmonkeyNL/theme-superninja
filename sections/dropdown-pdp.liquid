      "type": "text",
      "id": "asset_image_mobile",
      "label": "Asset image mobile (filename)",
      "info": "Optional fallback from assets folder when mobile image is not selected."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "Content",
          "default": "Why Super Ninja Works When Others Don't"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "HTML tag",
