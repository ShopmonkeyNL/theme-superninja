<div class='section-background color-{{ section.settings.color_scheme }}'></div>

<div
  class='section section--{{ section.settings.section_width }} spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %}'
>
  <div class='what-clients-say' style='{% render 'spacing-padding', settings: section.settings %}'>
    <div
      class='what-clients-say__left'
      style='{% render 'spacing-padding', settings: section.settings %}'
    >
      <div class='what-clients-say__heading-wrapper'>
        {% content_for 'block', type: 'text', id: 'text' %}
        {% content_for 'block', type: '_heading', id: 'heading', text: '' %}
      </div>
      {% content_for 'block', type: 'button', id: 'button' %}
    </div>


    <div class='what-clients-say__right'>
      {% for review in section.settings.review_product.metafields.judgeme.review_widget_data.value.reviews  limit: 11 %}
        {% render 'review-widget', title: review.title, paragraph: review.body, rating: review.rating, name: review.reviewer_name, date: review.created_at  %}
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  .what-clients-say {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    width: 100%;

    & .what-clients-say__left {
      flex: 1;

      display: flex;
      flex-direction: column;
      gap: 1.5rem;

      & .what-clients-say__heading-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        @media (min-width: 750px) {
          gap: 1rem;
        }
      }

      @media (min-width: 750px) {
        padding-block-start: var(--padding-block-start);
        padding-block-end: var(--padding-block-end);
        padding-inline-start: var(--padding-inline-start);
        padding-inline-end: var(--padding-inline-end);
      }
    }

    & .what-clients-say__right {
      flex: 1;

      @media (min-width: 750px) {
        column-count: 2;
        column-gap: 1rem;
      }
    }

    @media (max-width: 749px) {
      padding-block-start: var(--padding-block-start);
      padding-block-end: var(--padding-block-end);
      padding-inline-start: var(--padding-inline-start);
      padding-inline-end: var(--padding-inline-end);
    }

    @media (min-width: 750px) {
      flex-direction: row;
      gap: 2.5rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "What clients say",
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "_heading"
    },
    {
      "type": "button"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
        "type": "product",
        "id": "review_product",
        "label": "Review product"
    }
  ],
  "presets": [
    {
      "name": "What clients say",
      "category": "Shopmonkey - Custom"
    }
  ]
}
{% endschema %}
