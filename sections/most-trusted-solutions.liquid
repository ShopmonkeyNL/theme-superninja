{% comment %}
  Most trusted solutions – heading/text + reusable official product cards.
{% endcomment %}

{% liquid
  assign section_bg = section.settings.background_color | default: '#F0F2F1'
  assign product_blocks = section.blocks | where: 'type', 'product-card'
%}

<section
  class="most-trusted-solutions most-trusted-solutions--{{ section.id }}"
  style="--mts-bg: {{ section_bg }};"
  {{ section.shopify_attributes }}>
  <div class="most-trusted-solutions__inner">
    <div class="most-trusted-solutions__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% assign tag = block.settings.tag | default: 'h2' %}
            <{{ tag }} class="most-trusted-solutions__heading" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
              </{{ tag }}>
            {% when 'text' %}
              <div class="most-trusted-solutions__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      {% if product_blocks.size > 0 %}
        <div class="most-trusted-solutions__cards">
          {% for block in product_blocks %}
            {% render 'official-product-card'
              , block: block
              , product: block.settings.product %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <style>
    .most-trusted-solutions {
      padding-top: 48px;
      padding-bottom: 48px;
      padding-inline: 1.5rem;
      background: var(--mts-bg);
    }

    .most-trusted-solutions__inner {
      max-width: 1310px;
      margin: 0 auto;
    }

    .most-trusted-solutions__content {
      max-width: 860px;
      margin: 0 auto;
    }

    .most-trusted-solutions__heading {
      margin: 0 0 1rem;
      font-family: var(--font-heading--family);
      font-size: 64px;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      text-transform: uppercase;
    }

    .most-trusted-solutions__text {
      margin: 0;
      font-size: 24px;
      line-height: 1.5;
      text-align: center;
    }

    .most-trusted-solutions__text p {
      margin: 0;
    }

    .most-trusted-solutions__cards {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 410px));
      gap: 24px;
      justify-content: center;
    }

    .most-trusted-solutions__cards .official-product-card {
      max-width: 410px;
    }


    @media screen and (max-width: 768px) {
      .most-trusted-solutions__cards {
        grid-template-columns: 1fr;
      }
      .most-trusted-solutions {
        padding-inline: 1rem;
      }
      .most-trusted-solutions__heading {
        font-size: 40px !important;
        line-height: 1.3 !important;
      }
      .most-trusted-solutions__text {
        font-size: 14px !important;
        line-height: 1.5 !important;
      }
    }
  </style>

  {% schema %}
    {
      "name": "Most trusted solutions",
      "tag": "section",
      "class": "section-most-trusted-solutions",
      "settings": [
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#F0F2F1"
        }
      ],
      "blocks": [
        {
          "type": "heading",
          "name": "Heading",
          "limit": 1,
          "settings": [
            {
              "type": "inline_richtext",
              "id": "content",
              "label": "Content",
              "default": "Our Most Trusted Solutions"
            }, {
              "type": "select",
              "id": "tag",
              "label": "HTML tag",
              "options": [
                {
                  "value": "h1",
                  "label": "H1"
                }, {
                  "value": "h2",
                  "label": "H2"
                }, {
                  "value": "h3",
                  "label": "H3"
                }
              ],
              "default": "h2"
            }
          ]
        }, {
          "type": "text",
          "name": "Text",
          "limit": 1,
          "settings": [
            {
              "type": "richtext",
              "id": "content",
              "label": "Content",
              "default": "<p>Proven by thousands of households dealing with the same problem as you.</p>"
            }
          ]
        }, {
          "type": "product-card",
          "name": "Product card",
          "settings": [
            {
              "type": "product",
              "id": "product",
              "label": "Product"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Most trusted solutions",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "content": "Our Most Trusted Solutions",
                "tag": "h2"
              }
            }, {
              "type": "text",
              "settings": {
                "content": "<p>Proven by thousands of households dealing with the same problem as you.</p>"
              }
            }, {
              "type": "product-card",
              "settings": {}
            }
          ]
        }
      ]
    }
  {% endschema %}