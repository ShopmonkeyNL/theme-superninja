{% comment %}
  Customers feedback – heading (same style as Why Super Ninja Works).
{% endcomment %}

{% liquid
  assign section_bg = section.settings.background_color | default: '#F0F2F1'
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign section_gap = section.settings.gap | default: 32
  assign columns_gap = section.settings.columns_gap | default: 16
  assign border_radius = section.settings.border_radius | default: 0
  assign padding_block_start = section.settings['padding-block-start'] | default: 48
  assign padding_block_end = section.settings['padding-block-end'] | default: 128
  assign padding_inline_start = section.settings['padding-inline-start'] | default: 24
  assign padding_inline_end = section.settings['padding-inline-end'] | default: 24
%}

<section
  class="customers-feedback customers-feedback--{{ section.id }}"
  style="--cf-bg: {{ section_bg }}; --cf-section-gap: {{ section_gap }}px; --cf-columns-gap: {{ columns_gap }}px; --cf-card-radius: {{ border_radius }}px; --cf-pad-block-start: {{ padding_block_start }}px; --cf-pad-block-end: {{ padding_block_end }}px; --cf-pad-inline-start: {{ padding_inline_start }}px; --cf-pad-inline-end: {{ padding_inline_end }}px;"
  {{ section.shopify_attributes }}>
  <div class="customers-feedback__inner">
    <div class="customers-feedback__content">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'trust_badge' %}
            <div
              class="customers-feedback__trust-badge"
              style="text-align: {{ block.settings.badge_align }};"
              {{ block.shopify_attributes }}>
              <span class="customers-feedback__stars" aria-hidden="true">
                {% for i in (1..5) %}
                  <svg
                    class="customers-feedback__star"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    focusable="false">
                    <path d="M13.3057 0.843656C13.0648 0.328088 12.5558 0 11.9967 0C11.4377 0 10.9332 0.328088 10.6878 0.843656L7.76537 7.04452L1.2388 8.03816C0.693401 8.12253 0.238904 8.51623 0.0707399 9.05524C-0.0974239 9.59424 0.0389251 10.1895 0.429792 10.5879L5.16565 15.4201L4.04759 22.2491C3.95669 22.8115 4.18394 23.3833 4.63389 23.7161C5.08384 24.0489 5.67923 24.0911 6.17009 23.8239L12.0013 20.6133L17.8325 23.8239C18.3233 24.0911 18.9187 24.0536 19.3687 23.7161C19.8186 23.3786 20.0459 22.8115 19.955 22.2491L18.8324 15.4201L23.5682 10.5879C23.9591 10.1895 24.1 9.59424 23.9273 9.05524C23.7546 8.51623 23.3046 8.12253 22.7592 8.03816L16.2281 7.04452L13.3057 0.843656Z" fill="#FF5000" />
                  </svg>
                {% endfor %}
              </span>
              <span class="customers-feedback__trust-text">{{ block.settings.text }}</span>
            </div>

          {% when 'heading' %}
            {% liquid
              assign tag = block.settings.tag | default: 'h2'
              assign fs_d = block.settings.font_size_desktop | default: 64
              assign fs_m = block.settings.font_size_mobile | default: 40
              assign lh_d = block.settings.line_height_desktop | default: 1.2
              assign lh_m = block.settings.line_height_mobile | default: 1.3
              assign fw = block.settings.font_weight | default: '700'
              assign align = block.settings.text_align | default: 'center'
            %}
            <{{ tag }}
                            class="customers-feedback__heading"
                            style="--cf-fs-d: {{ fs_d }}px; --cf-fs-m: {{ fs_m }}px; --cf-lh-d: {{ lh_d }}; --cf-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
                            {{ block.shopify_attributes }}>
              {{ block.settings.content }}
              </{{ tag }}>

            {% when 'text' %}
              {% liquid
                assign fs_d = block.settings.font_size_desktop | default: 18
                assign fs_m = block.settings.font_size_mobile | default: 16
                assign lh_d = block.settings.line_height_desktop | default: 1.5
                assign lh_m = block.settings.line_height_mobile | default: 1.5
                assign fw = block.settings.font_weight | default: '400'
                assign align = block.settings.text_align | default: 'left'
              %}
              <div
                class="customers-feedback__text rte"
                style="--cf-text-fs-d: {{ fs_d }}px; --cf-text-fs-m: {{ fs_m }}px; --cf-text-lh-d: {{ lh_d }}; --cf-text-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
                {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </div>

          {% when 'video' %}
            {% comment %} Rendered in carousel below {% endcomment %}
          {% endcase %}
        {% endfor %}
      </div>

      {% if video_blocks.size > 0 %}
        {% capture slide_markup %}
          {% for block in video_blocks %}
            {% liquid
              assign vid = block.settings.video
              assign vid_url = block.settings.video_url
              assign use_url = false
              assign preview_img = nil
              if block.settings.source == 'url' and vid_url != blank
                assign use_url = true
                if block.settings.cover_image != blank
                  assign preview_img = block.settings.cover_image
                elsif vid_url.type == 'youtube' and vid_url.id != blank
                  assign youtube_thumb = 'https://img.youtube.com/vi/' | append: vid_url.id | append: '/maxresdefault.jpg'
                  assign preview_img = youtube_thumb
                elsif vid_url.preview_image != blank
                  assign preview_img = vid_url.preview_image
                endif
              elsif vid != blank
                if vid.preview_image != blank
                assign preview_img = vid.preview_image
                elsif vid.thumbnail != blank
                  assign preview_img = vid.thumbnail
                elsif vid.host == 'youtube' and vid.id != blank
                  assign youtube_thumb = 'https://img.youtube.com/vi/' | append: vid.id | append: '/maxresdefault.jpg'
                  assign preview_img = youtube_thumb
                endif
              endif
              assign has_video = false
              if use_url and vid_url != blank
                assign has_video = true
              elsif vid != blank
                assign has_video = true
              endif
            %}
            <div class="customers-feedback__video-card" {{ block.shopify_attributes }} data-block-id="{{ block.id }}" data-cf-has-video="{{ has_video }}">
              <button type="button" class="customers-feedback__video-trigger" aria-label="{{ 'sections.customers_feedback.play_video' | t | default: 'Play video' }}" data-cf-open-modal="{{ section.id }}" {% unless has_video %}disabled{% endunless %}>
                <span class="customers-feedback__video-poster">
                  {% if preview_img != blank %}
                    {% if preview_img contains 'http://' or preview_img contains 'https://' %}
                      <img src="{{ preview_img }}" loading="lazy" width="626" height="auto" alt="" style="width: 100%; height: 100%; object-fit: cover; display: block;">
                    {% else %}
                      {{ preview_img | image_url: width: 626 | image_tag: loading: 'lazy', widths: '340, 626', sizes: '(max-width: 749px) 170px, 313px', alt: '' }}
                    {% endif %}
                  {% else %}
                    <span class="customers-feedback__video-placeholder"></span>
                  {% endif %}
                </span>
                <span class="customers-feedback__video-play" aria-hidden="true">
                  <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" fill="#FF5000"/><path d="M26 18L12 26L12 10L26 18Z" fill="#F0F2F1"/></svg>
                </span>
              </button>
              {% if has_video %}
                <div class="customers-feedback__video-embed" hidden data-cf-embed>
                  {% if use_url and vid_url != blank %}
                    {% if vid_url.type == 'youtube' %}
                      <iframe data-src="https://www.youtube.com/embed/{{ vid_url.id }}?autoplay=1" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen title="YouTube"></iframe>
                    {% elsif vid_url.type == 'vimeo' %}
                      <iframe data-src="https://player.vimeo.com/video/{{ vid_url.id }}?autoplay=1" loading="lazy" allow="autoplay; fullscreen" allowfullscreen title="Vimeo"></iframe>
                    {% endif %}
                  {% elsif vid != blank %}
                    {% if vid.host == 'youtube' %}
                      {{ vid | external_video_url: autoplay: true | external_video_tag: class: 'customers-feedback__video-tag' }}
                    {% elsif vid.host == 'vimeo' %}
                      {{ vid | external_video_url: autoplay: true | external_video_tag: class: 'customers-feedback__video-tag' }}
                    {% else %}
                      {{ vid | video_tag: autoplay: true, controls: true, class: 'customers-feedback__video-tag' }}
                    {% endif %}
                  {% endif %}
                </div>
              {% endif %}
            </div>
            {% unless forloop.last %}<!--@cf/slidesplit-->{% endunless %}
          {% endfor %}
        {% endcapture %}
        {% liquid
          assign slides = slide_markup | split: '<!--@cf/slidesplit-->'
          assign slide_count = video_blocks.size
          assign carousel_ref = 'customersFeedbackCarousel' | append: section.id
        %}
        <div class="customers-feedback__videos-wrap">
          {% render 'resource-list-swiper', ref: carousel_ref, slides: slides, slide_count: slide_count, settings: section.settings %}
        </div>

        <div class="customers-feedback__modal" id="cf-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'sections.customers_feedback.video_modal' | t | default: 'Video' }}" hidden>
          <div class="customers-feedback__modal-backdrop" data-cf-close-modal="{{ section.id }}"></div>
          <div class="customers-feedback__modal-content">
            <button type="button" class="customers-feedback__modal-close" aria-label="{{ 'sections.customers_feedback.close' | t | default: 'Close' }}" data-cf-close-modal="{{ section.id }}"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
            <div class="customers-feedback__modal-body" data-cf-modal-body></div>
          </div>
        </div>
      {% endif %}
  </div>
</section>

  {% style %}
    .customers-feedback {
      padding-top: var(--cf-pad-block-start, 48px);
      padding-bottom: var(--cf-pad-block-end, 128px);
      padding-inline-start: var(--cf-pad-inline-start, 24px);
      padding-inline-end: var(--cf-pad-inline-end, 24px);
      background: var(--cf-bg);
    }

    .customers-feedback__inner {
      max-width: 1312px;
      margin: 0 auto;
    }

    .customers-feedback__content {
      max-width: 100%;
    }

    .customers-feedback__trust-badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
      font-size: 16px;
      line-height: 1;
      color: #1C1C1C;
      margin-bottom: 1rem;
    }

    .customers-feedback__stars {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .customers-feedback__star {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .customers-feedback__trust-text {
      font-size: 16px;
      line-height: 1.2;
      font-weight: 400;
    }

    .customers-feedback__heading {
      margin: 0;
      color: #1C1C1C;
      font-family: var(--font-heading--family);
      font-size: var(--cf-fs-d, 64px);
      line-height: var(--cf-lh-d, 1.2);
      font-weight: 700;
      text-transform: uppercase;
      text-align: center;
    }

    .customers-feedback__heading p {
      margin: 0;
    }

    .customers-feedback__text {
      margin: 0.5em 0 0;
      font-size: var(--cf-text-fs-d, 18px);
      line-height: var(--cf-text-lh-d, 1.5);
      color: #000;
    }

    .customers-feedback__text p {
      margin: 0 0 0.5em;
    }

    .customers-feedback__text p:last-child {
      margin-bottom: 0;
    }

    /* Video carousel */
    .customers-feedback__videos-wrap {
      margin-top: var(--cf-section-gap, 32px);
      overflow: hidden;
      --swiper-gap: var(--cf-columns-gap, 16px);
      --swiper-gap-mobile: calc(var(--cf-columns-gap, 16px) / 2);
    }

    .customers-feedback__video-card {
      flex: 0 0 auto;
      width: 100%;
      aspect-ratio: 313 / 556;
      height: auto;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .customers-feedback__video-trigger {
      display: block;
      width: 100%;
      height: 100%;
      position: relative;
      border: none;
      border-radius: var(--cf-card-radius, 0px);
      padding: 0;
      cursor: pointer;
      background: #000;
      overflow: hidden;
    }
    .customers-feedback__video-trigger:disabled {
      cursor: default;
    }
    .customers-feedback__video-trigger:disabled .customers-feedback__video-play {
      opacity: 0.6;
    }

    .customers-feedback__video-poster {
      display: block;
      width: 100%;
      height: 100%;
      position: absolute;
      inset: 0;
    }

    .customers-feedback__video-poster img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .customers-feedback__video-placeholder {
      display: block;
      width: 100%;
      height: 100%;
      background: #ddd;
    }

    .customers-feedback__video-play {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .customers-feedback__video-play svg {
      width: 100%;
      height: 100%;
    }

    /* Modal */
    .customers-feedback__modal {
      position: fixed;
      inset: 0;
      z-index: var(--layer-heightened, 1000);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .customers-feedback__modal[hidden] {
      display: none !important;
    }

    .customers-feedback__modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.75);
      cursor: pointer;
    }

    .customers-feedback__modal-content {
      position: relative;
      width: 100%;
      max-width: 90vw;
      max-height: 90vh;
      aspect-ratio: 9 / 16;
      background: #000;
    }

    .customers-feedback__modal-close {
      position: absolute;
      top: -40px;
      right: 0;
      width: 36px;
      height: 36px;
      border: none;
      background: none;
      color: #fff;
      cursor: pointer;
      z-index: var(--layer-raised, 2);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .customers-feedback__modal-close svg {
      width: 24px;
      height: 24px;
    }

    .customers-feedback__modal-body {
      width: 100%;
      height: 100%;
      position: relative;
    }

    .customers-feedback__modal-body iframe,
    .customers-feedback__modal-body .customers-feedback__video-tag {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .customers-feedback__modal-body video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    @media screen and (max-width: 749px) {
      .customers-feedback__heading {
        font-size: var(--cf-fs-m, 40px) !important;
        line-height: var(--cf-lh-m, 1.3) !important;
        text-align: center !important;
      }
      .customers-feedback__text {
        font-size: var(--cf-text-fs-m, 16px) !important;
        line-height: var(--cf-text-lh-m, 1.5) !important;
      }
      .customers-feedback__trust-badge {
        justify-content: center !important;
      }
      .customers-feedback__trust-text {
        font-size: 12px !important;
      }
      .customers-feedback__star {
        width: 16px !important;
        height: 16px !important;
      }
      .customers-feedback {
        padding-inline-start: 16px;
        padding-inline-end: 16px;
      }
    }
  {% endstyle %}

  <script>
    (function() {
      const section = document.querySelector('.customers-feedback--{{ section.id }}');
      if (!section) return;

      const modal = document.getElementById('cf-modal-{{ section.id }}');
      const modalBody = modal ? modal.querySelector('[data-cf-modal-body]') : null;
      if (!modal || !modalBody) return;

      const abortController = new AbortController();
      const signal = abortController.signal;

      function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = '';
        const iframes = modalBody.querySelectorAll('iframe');
        const video = modalBody.querySelector('video');
        if (iframes && iframes.length) {
          iframes.forEach(function(iframe) {
            iframe.src = '';
          });
        }
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
        modalBody.innerHTML = '';
      }

      section.addEventListener('click', function(e) {
        const btn = e.target.closest('[data-cf-open-modal="{{ section.id }}"]');
        if (!btn || btn.disabled) return;

        const card = btn.closest('.customers-feedback__video-card');
        const embed = card ? card.querySelector('[data-cf-embed]') : null;
        if (!embed || embed.innerHTML.trim() === '') return;

        modalBody.innerHTML = '';
        var clone = embed.cloneNode(true);
        clone.removeAttribute('hidden');
        clone.querySelectorAll('iframe[data-src]').forEach(function(iframe) {
          iframe.setAttribute('src', iframe.getAttribute('data-src'));
        });
        modalBody.appendChild(clone);
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
      }, { signal: signal });

      modal.querySelectorAll('[data-cf-close-modal]').forEach(function(btn) {
        btn.addEventListener('click', closeModal, { signal: signal });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.hidden) {
          closeModal();
        }
      }, { signal: signal });

      document.addEventListener('shopify:section:unload', function(e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          if (!modal.hidden) closeModal();
          abortController.abort();
        }
      }, { signal: signal });
    })();
  </script>

  {% schema %}
    {
      "name": "Customers feedback",
      "tag": "section",
      "class": "section-customers-feedback",
      "settings": [
        {
          "type": "color",
          "id": "background_color",
          "label": "Background color",
          "default": "#F0F2F1"
        },
        {
          "type": "header",
          "content": "Carousel layout"
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Slides per view (desktop)",
          "min": 1,
          "max": 8,
          "step": 1,
          "default": 4
        },
        {
          "type": "range",
          "id": "mobile_columns_carousel",
          "label": "Slides per view (mobile)",
          "min": 1,
          "max": 3,
          "step": 0.1,
          "default": 1.5
        },
        {
          "type": "range",
          "id": "columns_gap",
          "label": "Slide gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Content to carousel gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 32
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "Card border radius",
          "min": 0,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "select",
          "id": "section_width",
          "label": "t:settings.width",
          "options": [
            {
              "value": "page-width",
              "label": "t:options.page"
            },
            {
              "value": "full-width",
              "label": "t:options.full"
            }
          ],
          "default": "page-width"
        },
        {
          "type": "header",
          "content": "t:content.navigation"
        },
        {
          "type": "checkbox",
          "id": "show_arrows",
          "label": "Show arrows (desktop)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_arrows_mobile",
          "label": "Show arrows (mobile)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_dots",
          "label": "Show dots (desktop)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_dots_mobile",
          "label": "Show dots (mobile)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop slides",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay slides",
          "default": false
        },
        {
          "type": "range",
          "id": "autoplay_timeout",
          "label": "Autoplay timeout",
          "min": 1000,
          "max": 9900,
          "step": 100,
          "unit": "ms",
          "default": 2500,
          "visible_if": "{{ section.settings.autoplay == true }}"
        },
        {
          "type": "select",
          "id": "icons_style",
          "label": "t:settings.icon",
          "options": [
            {
              "value": "arrow",
              "label": "t:options.arrows"
            },
            {
              "value": "chevron",
              "label": "t:options.chevrons"
            },
            {
              "value": "arrows_large",
              "label": "t:options.arrows_large"
            },
            {
              "value": "chevron_large",
              "label": "t:options.chevron_large"
            },
            {
              "value": "none",
              "label": "t:options.none"
            }
          ],
          "default": "arrow"
        },
        {
          "type": "select",
          "id": "icons_shape",
          "label": "t:settings.icon_background",
          "options": [
            {
              "value": "none",
              "label": "t:options.none"
            },
            {
              "value": "circle",
              "label": "t:options.circle"
            },
            {
              "value": "square",
              "label": "t:options.square"
            }
          ],
          "default": "none",
          "visible_if": "{{ section.settings.icons_style != 'none' }}"
        },
        {
          "type": "header",
          "content": "Padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "Top",
          "min": 0,
          "max": 160,
          "step": 2,
          "unit": "px",
          "default": 48
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "Bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 128
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "Left",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 24
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "Right",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 24
        }
      ],
      "blocks": [
        {
          "type": "trust_badge",
          "name": "Trust badge",
          "limit": 1,
          "settings": [
            {
              "type": "inline_richtext",
              "id": "text",
              "label": "Text",
              "default": "Trusted by <strong>1000+</strong> happy customers"
            },
