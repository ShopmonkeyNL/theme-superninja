{% comment %}
  PDP Stats Section – displays heading, text, and stat blocks
{% endcomment %}

{% liquid
  assign stat_number_color = section.settings.stat_number_color | default: '#FF5000'
%}

<section class="pdp-stats-section" style="--pdp-stats-number-color: {{ stat_number_color }};" {{ section.shopify_attributes }}>
  <img src="{{ 'moth.png' | asset_url }}" alt="" class="pdp-stats-section__moth" width="200" height="200" loading="lazy">
  <div class="pdp-stats-section__inner">
    <div class="pdp-stats-section__header">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% liquid
              assign tag = block.settings.tag | default: 'h2'
              assign fs_d = block.settings.font_size_desktop | default: 32
              assign fs_m = block.settings.font_size_mobile | default: 24
              assign lh_d = block.settings.line_height_desktop | default: 1.2
              assign lh_m = block.settings.line_height_mobile | default: 1.3
              assign fw = block.settings.font_weight | default: '700'
              assign align = block.settings.text_align | default: 'left'
            %}
            <{{ tag }}
              class="pdp-stats-section__heading"
              style="--pdp-stats-fs-d: {{ fs_d }}px; --pdp-stats-fs-m: {{ fs_m }}px; --pdp-stats-lh-d: {{ lh_d }}; --pdp-stats-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
              {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </{{ tag }}>

          {% when 'text' %}
            {% liquid
              assign fs_d = block.settings.font_size_desktop | default: 18
              assign fs_m = block.settings.font_size_mobile | default: 16
              assign lh_d = block.settings.line_height_desktop | default: 1.5
              assign lh_m = block.settings.line_height_mobile | default: 1.5
              assign fw = block.settings.font_weight | default: '400'
              assign align = block.settings.text_align | default: 'left'
            %}
            <div
              class="pdp-stats-section__text rte"
              style="--pdp-stats-text-fs-d: {{ fs_d }}px; --pdp-stats-text-fs-m: {{ fs_m }}px; --pdp-stats-text-lh-d: {{ lh_d }}; --pdp-stats-text-lh-m: {{ lh_m }}; font-weight: {{ fw }}; text-align: {{ align }};"
              {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
    
    <div class="pdp-stats-section__stats-wrapper">
      {% assign stat_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'stat_item' and stat_count < 3 %}
          <div class="pdp-stats-section__stat" {{ block.shopify_attributes }}>
            <div class="pdp-stats-section__stat-number">{{ block.settings.number }}</div>
            <div class="pdp-stats-section__stat-label">{{ block.settings.label }}</div>
          </div>
          {% assign stat_count = stat_count | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .pdp-stats-section {
    position: relative;
    width: 100%;
    padding: 100px 16px 48px 16px;
    background-color: #FFFFFF;
    overflow: hidden;
  }

  .pdp-stats-section__moth {
    position: absolute;
    top: 50px;
    left: 0;
    width: auto;
    height: 120px;
    z-index: 1;
    pointer-events: none;
    animation: moth-float 3s ease-in-out infinite;
  }

  @keyframes moth-float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes moth-float-mobile {
    0%, 100% {
      transform: rotate(180deg) translateY(0);
    }
    50% {
      transform: rotate(180deg) translateY(-20px);
    }
  }

  .pdp-stats-section__inner {
    max-width: 1312px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .pdp-stats-section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .pdp-stats-section__heading {
    font-family: var(--font-heading--family);
    font-size: var(--pdp-stats-fs-d);
    line-height: var(--pdp-stats-lh-d);
    text-transform: uppercase;
    color: #1C1C1C;
    margin: 0;
  }

  .pdp-stats-section__text {
    font-family: var(--font-primary--family);
    font-size: var(--pdp-stats-text-fs-d);
    line-height: var(--pdp-stats-text-lh-d);
    color: #666666;
    margin: 0;
  }

  .pdp-stats-section__stats-wrapper {
    display: flex;
    gap: 48px;
    width: 100%;
    justify-content: center;
  }

  .pdp-stats-section__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
    max-width: calc(33.333% - 32px);
  }

  .pdp-stats-section__stat-number {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 56px;
    line-height: 100%;
    letter-spacing: 0px;
    text-align: center;
    text-transform: uppercase;
    color: var(--pdp-stats-number-color, #FF5000);
  }

  .pdp-stats-section__stat-label {
    font-family: 'Tahoma', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0px;
    text-align: center;
    color: #666666;
  }

  @media (max-width: 1121px){
    .pdp-stats-section__stat-number{
    font-size: 98px;
    }
  }

  @media (max-width: 888px){
    .pdp-stats-section__stat-number{
    font-size: 80px;
    }
  }


  @media screen and (max-width: 749px) {
    .pdp-stats-section {
      padding: 100px 16px 48px 16px;
    }

    .pdp-stats-section__inner {
      gap: 16px;
    }

    .pdp-stats-section__heading {
      font-size: var(--pdp-stats-fs-m);
      line-height: var(--pdp-stats-lh-m);
    }

    .pdp-stats-section__text {
      font-size: var(--pdp-stats-text-fs-m);
      line-height: var(--pdp-stats-text-lh-m);
    }

    .pdp-stats-section__stats-wrapper {
      flex-direction: column;
      gap: 24px;
      width: fit-content;
    }

    .pdp-stats-section__stat {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 16px;
      max-width: fit-content;
    }

    .pdp-stats-section__stat-number {
      font-size: 36px;
      flex-shrink: 0;
    }

    .pdp-stats-section__stat-label {
      font-size: 15px;
    }
    .pdp-stats-section__moth {
      top: auto;
      bottom: 0;
      left: auto;
      height: 90px;
      right: 0;
      animation: moth-float-mobile 3s ease-in-out infinite;
    }
  }

</style>

