{% assign best_for_translation = 'products.product.best_for' | t %}
{% assign description_translation = 'products.product.description' | t %}
{% assign ingredients_translation = 'products.product.ingredients' | t %}
{% assign shipping_and_returns_translation = 'products.product.shipping_and_returns' | t %}

{% assign tabs_array = product.metafields.custom.best_for_list.value %}

{% for tab in tabs_array %}
  <div>{{ tab }}</div>
{% endfor %}

<div class='section-background color-{{ section.settings.color_scheme }}'></div>

<div
  class='section section--{{ section.settings.section_width }} spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %}'
  style='{% render 'spacing-padding', settings: section.settings %}'
>
  <div class='container'>
    <div class="section-product-tabs" style="{% if section.settings.border > 0 %}--border-width: {{ section.settings.border }}px;{% endif %}">
      
      <div class="section-product-tabs__heading">
        {% if product.metafields.custom.best_for_list %}
          {% render 'product-tab-heading' field: 'best-for' translation: best_for_translation  %}
        {% endif %}
        
        {% if product.description %}
          {% render 'product-tab-heading' field: 'description' translation: description_translation  %}
        {% endif %}
        
        {% if product.metafields.custom.ingredients %}
          {% render 'product-tab-heading' field: 'ingredients' translation: ingredients_translation  %}
        {% endif %}
        
        {% if settings.shipping_and_returns %}
          {% render 'product-tab-heading' field: 'shipping-and-returns' translation: shipping_and_returns_translation  %}
        {% endif %}
      </div>

      <div class="section-product-tabs__content">
        content
      </div>
    </div>
  </div>
</div>

{% style %}
  .section-product-tabs {
    border: var(--border-width) solid var(--border-color);

    & .section-product-tabs__heading {
      display: flex;
      padding-block: 1.5rem;
      border-block-end: 0.5px solid var(--border-color);
      overflow-x: auto;

      & .heading-item {
        font-family: var(--font-heading--family);
        text-transform: uppercase;

        padding-inline: 2.5rem;

        &.active {
          color: var(--color-primary-button-background)
        }
      }
    }

    & .section-product-tabs__content {
      padding: 1.5rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "default": 0.5,
      "min": 0,
      "max": 4,
      "step": 0.5
    }
  ],
  "presets": [
    {
      "name": "Product tabs"
    }
  ]
}
{% endschema %}
