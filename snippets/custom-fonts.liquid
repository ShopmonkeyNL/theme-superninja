{% style %}
  /* Headings */
  @font-face {
    font-display: swap;
    font-family: 'PT Sans Narrow';
    font-style: normal;
    font-weight: 700;
    src: url({{ 'pt-sans-narrow-v19-latin-700.woff2' | asset_url }}) format('woff2');
  }

  /* Body */
  @font-face {
    font-display: swap;
    font-family: 'PT Sans';
    font-style: normal;
    font-weight: 400;
    src: url({{ 'pt-sans-v18-latin-regular.woff2' | asset_url }}) format('woff2');
  }

  @font-face {
    font-display: swap;
    font-family: 'PT Sans';
    font-style: normal;
    font-weight: 700;
    src: url({{ 'pt-sans-v18-latin-700.woff2' | asset_url }}) format('woff2');
  }

  /* Subtitle */
  @font-face {
    font-display: swap;
    font-family: 'Bangers';
    font-style: normal;
    font-weight: 400;
    src: url({{ 'bangers-v25-latin-regular.woff2' | asset_url }}) format('woff2');
  }
{% endstyle %}
