<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" {% if last %}class="breadcrumbs__last" aria-current="page"{% endif %}>
  {% unless last %}
  <a itemprop="item" href="{{ url }}">
    <span itemprop="name">{{ name }}</span>
  </a>
  {% endunless %}

  {% if last %}
    <span itemprop="nane">{{ name }}</span>
  {% endif %}

  <meta itemprop="position" content="{{ position }}" />
</li>