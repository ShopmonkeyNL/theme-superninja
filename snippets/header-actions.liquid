<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

<header-actions
  {{- block.shopify_attributes -}}
>
  {% if show_account and shop.customer_accounts_enabled %}
    {% render 'search' %}
    {% render 'account-popover' %}
    {% render 'account-drawer' %}
  {% endif %}

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    {% render 'cart-drawer' %}
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="header-actions__action action__cart"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
    >
      {% render 'cart-icon-component' %}
    </a>
  {% endif %}
</header-actions>

{% stylesheet %}
  .cart-drawer {
    --cart-drawer-padding: var(--padding-lg) var(--padding-xl);
    --cart-drawer-padding-desktop: var(--padding-xl) var(--padding-2xl);
    --cart-font-size--2xs: var(--font-size--2xs);
    --cart-font-size--xs: var(--font-size--xs);
    --cart-font-size--sm: var(--font-size--sm);
    --cart-font-size--md: var(--font-size--md);
    --cart-font-size--2xl: var(--font-size--2xl);
  }

  .cart-drawer__dialog {
    position: fixed;
    border-radius: 0;
    width: min(390px, 95vw);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border-left: var(--style-border-drawer);
    box-shadow: var(--shadow-drawer);
    background-color: var(--color-background);
  }

  @media screen and (min-width: 750px) {
    .cart-drawer__dialog {
      width: min(500px, 95vw);
    }
  }

  /* Needed to ensure the drawer is full height */
  .cart-drawer__dialog:modal {
    max-height: 100dvh;
    overflow-y: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
  }

  .cart-drawer__content {
    padding: 0;
    background-color: var(--color-background);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    background-color: #F0F2F1;
  }

  .cart-drawer__header-title {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }

  .cart-drawer__header-icon {
    display: inline-flex;
    width: 31px;
    height: 31px;
    flex-shrink: 0;
  }

  .cart-drawer__header-icon svg {
    width: 100%;
    height: 100%;
  }

  .cart-drawer__heading {
    margin: 0;
    color: #1c1c1c;
    font-family: Bahnschrift;
    font-weight: 700;
    font-stretch: condensed;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;

    @media screen and (min-width: 750px) {
      font-size: 30px!important;
    }
  }

  .cart-drawer__close-button {
    margin-right: 0;
    flex-shrink: 0;
  }

  .cart-drawer__header {
    border-width: 2px 0 2px 0;
    border-style: solid;
    border-color: #ff5000;
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__heading {
    margin-bottom: var(--margin-md);
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid var(--color-border);
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xl);
    padding: 0;
    border-top: 1.56px solid #FF5000;
    margin-top: 0;
    background-color: var(--color-background);

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__original-total-container:empty)) {
    border-block-start: var(--style-border-width) solid var(--color-border);
    padding-block-start: var(--padding-2xl);
    padding-left: 16px;
    padding-right: 16px;
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer__heading--empty {
    display: flex;
    justify-content: center;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
    padding-top: 20px;
    @media screen and (min-width: 750px) {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid var(--color-border);
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  /* Cart drawer - cart items layout com flex: imagem | info (máx espaço) | quantidade (mín necessário) */
  .cart-drawer__items .cart-items--drawer .cart-items__table-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 var(--gap-md);
  }

  .cart-drawer__items .cart-items--drawer .cart-items__media {
    flex: 0 0 auto;
    width: 110px;
    height: 110px;
  }

  .cart-drawer__items .cart-items--drawer .cart-items__details {
    flex: 1 1 0;
    min-width: 0;
  }

  .cart-drawer__items .cart-items--drawer .cart-items__quantity {
    flex: 0 0 auto;
    order: 0;
  }

  .cart-drawer__items .cart-items--drawer .cart-items__error {
    flex: 1 1 100%;
    width: 100%;
    order: 10;
  }

  .cart-drawer__items .cart-items__price--drawer-hidden {
    display: none;
  }

  .cart-drawer__items .cart-items__details-drawer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
  }

  .cart-drawer__items .cart-items__title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }

  .cart-drawer__items .cart-items__quantity-bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    /* padding: 0 6px; */
    background-color: #1c1c1c;
    color: #fff;
    font-family: Bahnschrift;
    font-size: 14px;
    font-weight: 700;
    font-stretch: condensed;
    line-height: 1;
    text-align: center;
    border-radius: 50%;
    position: absolute;
    border: 1px solid #fff;
    top: -4px;
    right: -8px;
  }

  .cart-drawer__items .cart-items__title {
    font-family: Bahnschrift;
    font-weight: 700;
    font-size: 20px!important;
    font-stretch: condensed;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #1c1c1c;
    text-decoration: none;

    @media screen and (min-width: 750px) {
      font-size: 30px!important;
    }
  }

  .cart-drawer__items .cart-items__variant-drawer {
    margin: 0;
    font-family: Bahnschrift;
    font-weight: 400;
    font-stretch: condensed;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #1c1c1c;
  }

  .cart-drawer__items .cart-items__price-drawer {
    margin: 0;
    font-family: Bahnschrift;
    font-weight: 700;
    font-size: 20px;
    font-stretch: condensed;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #1c1c1c;
  }

  .cart-drawer__items .cart-items__remove--drawer {
    width: auto;
    height: auto;
    min-height: unset;
    padding: 0;
    background: transparent;
    background-image: none;
    background-color: transparent;
    font-family: Bahnschrift;
    font-weight: 700;
    font-size: 20px;
    font-stretch: condensed;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #ff5000;
    box-shadow: none;
    align-self: flex-start;
  }

  .cart-drawer__items .cart-items__remove--drawer:hover,
  .cart-drawer__items .cart-items__remove--drawer:focus {
    color: #ff5000;
    text-decoration: underline;
    background: transparent;
    background-image: none;
  }

  .cart-drawer__items .quantity-selector-wrapper--drawer {
    gap: 0 !important;
    flex-wrap: nowrap;
    width: fit-content;
    max-width: 70px;
  }

  .cart-drawer__items .quantity-selector--drawer {
    display: flex;
    align-items: center;
    gap: 0 !important;
    flex-wrap: nowrap;
    width: fit-content;
    max-width: 70px;
  }

  .cart-drawer__items .quantity-selector__input--drawer-hidden {
    position: absolute !important;
    width: 0 !important;
    min-width: 0 !important;
    height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    flex: 0 0 0 !important;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .cart-drawer__items .quantity-selector__button--drawer {
    width: 29px;
    min-width: 29px;
    height: 29px;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cart-drawer__items .quantity-selector__button--drawer svg {
    width: 29px;
    height: 29px;
  }

  .cart-drawer__items .cart-items__quantity {
    margin-block-start: 0;
    align-self: center;
    width: fit-content;
    max-width: 70px;
    min-width: 58px;
    padding: 0;
    gap: 0;
  }

  .cart-drawer__items .cart-items__quantity-controls {
    gap: 0;
    max-width: 70px;
    width: fit-content;
  }

  .cart-drawer__items .cart-items__quantity .quantity-selector--drawer {
    justify-content: flex-start;
    background: transparent;
    flex-direction: row-reverse;
  }

  .cart-drawer--empty .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    margin-top: 0;
  }

  .cart-drawer:not(:has(.cart-form)) .cart-drawer__content {
    justify-content: center;
  }

  .cart-drawer--empty .cart-drawer__header {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-drawer--empty .cart-drawer__heading {
    text-align: center;
  }

  .cart-drawer:not(:has(.cart-form)) .cart-items__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  header-actions {
    display: flex;

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
    }

    @media (min-width: 992px) {
      search-button {
        display: none !important;
      }
    }
  }

  .header__column--right header-actions {
    margin-inline-start: calc(var(--gap-md) * -1);
  }

  .header-actions__action {
    --button-color: var(--color-foreground);

    cursor: pointer;
    display: flex;
    justify-content: center;
  }

  .header-actions__action .svg-wrapper {
    height: var(--button-size);
    width: var(--button-size);
  }

  .header-actions__action svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  .header-actions__cart-icon {
    --cart-bubble-size: 20px;
    --cart-bubble-top: 4.5px;
    --cart-bubble-right: 2.5px;

    position: relative;
  }

  .header-actions__cart-icon .cart-bubble {
    position: absolute;
    width: var(--cart-bubble-size, 20px);
    top: var(--cart-bubble-top);
    right: var(--cart-bubble-right);
  }

  .header-actions__cart-icon .cart-bubble__text,
  .cart-drawer__heading .cart-bubble__text {
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
  }

  .header-actions__cart-icon.header-actions__cart-icon--has-cart svg {
    /* Create donut mask where the cart bubble sits */
    mask: radial-gradient(
      calc(var(--cart-bubble-size) + 2px) at calc(100% - var(--cart-bubble-right)) var(--cart-bubble-top),
      transparent 45.45%,
      #fff 45.45%,
      #fff 100%
    );
  }

  .cart-drawer__heading .cart-bubble__background {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-drawer__heading .cart-bubble__text {
    color: var(--color-foreground);
    font-size: var(--font-size--xs);
  }

  .cart-bubble--animating .cart-bubble__background {
    animation: grow var(--animation-speed) var(--animation-easing);
  }

  .cart-bubble--animating .cart-bubble__text {
    animation: cartBubbleSlideIn var(--animation-speed) var(--animation-easing);
  }
  @media screen and (max-width: 749px) {
    .cart-drawer__items .cart-items__variant-drawer,.cart-drawer__items .cart-items__price-drawer,.cart-drawer__items .cart-items__remove--drawer{
      font-size: 16px;
    }
    .cart-drawer__heading{
      font-size: 20px!important;
    }
    .cart-drawer__items .cart-items--drawer .cart-items__media{
      width: 90px;
      height: 90px;
    }
  }
{% endstylesheet %}
