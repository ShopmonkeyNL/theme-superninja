{%- doc -%}
  Renders the cart summary: subtotal, checkout button, trust badges.
{%- enddoc -%}

{%- liquid
  if settings.currency_code_enabled_cart_total
    assign total_price = cart.total_price | money_with_currency
  else
    assign total_price = cart.total_price | money
  endif
-%}

<div class="cart__summary-totals cart-summary-sn">
  <div class="cart-summary-sn__row">
    <span class="cart-summary-sn__label">Subtotal</span>
    <text-component ref="cartTotal" value="{{ total_price | strip_html }}" class="cart-summary-sn__price" data-cart-subtotal>
      {{ total_price }}
    </text-component>
  </div>

  <div class="cart-summary-sn__ctas">
    <button
      type="submit"
      id="checkout"
      class="cart-summary-sn__checkout button"
      name="checkout"
      {% if cart.empty? %}disabled{% endif %}
      form="cart-form"
    >
      {{ 'content.checkout' | t }}
    </button>
  </div>

