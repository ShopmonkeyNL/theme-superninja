{% style %}
  .cart-summary-sn {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    border-top: 2px solid #FF5000;
    padding-top: var(--cart-drawer-summary-padding, 24px);
  }

  .cart-summary-sn__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .cart-summary-sn__label {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-style: var(--font-heading--style, normal);
    font-size: 30px;
    line-height: 100%;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #FF5000;
  }

  .cart-summary-sn__price {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-style: var(--font-heading--style, normal);
    font-size: 24px;
    line-height: 100%;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #1C1C1C;
  }

  .cart-summary-sn__ctas {
    width: 100%;
  }

  .cart-summary-sn__checkout {
    width: 100%;
    padding: 16px 48px;
    background: #94D357;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-style: var(--font-heading--style, normal);
    font-size: 48px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
    color: #1C1C1C;
    border: none;
    cursor: pointer;
    opacity: 1;
    border-radius: 0;
  }

  .cart-summary-sn__checkout:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .cart-summary-sn__trust {
    display: flex;
    flex-wrap: nowrap;
    gap: 12px 16px;
    align-items: center;
    justify-content: center;
    padding-bottom: 24px;
  }

  .cart-summary-sn__trust-item {
    display: flex;
    align-items: center;
    width: 33%;
    gap: 8px;
  }

  .cart-summary-sn__trust-icon {
    flex-shrink: 0;
    line-height: 0;
  }

  .cart-summary-sn__trust-icon svg {
    width: 36px;
    height: auto;
    display: block;
  }

  .cart-summary-sn__trust-text {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-style: var(--font-heading--style, normal);
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #1C1C1C;
  }

  @media (max-width: 749px) {
    .cart-summary-sn__label,
    .cart-summary-sn__price {
      font-size: 20px;
    }

    .cart-summary-sn__checkout {
      font-size: 36px;
      padding: 16px 24px;
    }

    .cart-summary-sn__trust-text {
      font-size: 16px;
    }
    .cart-summary-sn__trust-icon svg{
      width: 24px!important;
    }
  }
{% endstyle %}

{% comment %}
  LEGACY: previous cart summary (discounts, cart note, discount code, estimated total, installments, tax note, additional checkout buttons).
  Restore from version control if needed.

  <div class="cart__summary-totals">
    <div class="cart__original-total-container">... discounts ...</div>
    {% if settings.show_cart_note or settings.show_add_discount_code %}
      <div class="cart-actions">... cart-note, cart-discount ...</div>
    {% endif %}
    <div class="cart__total-container">
      <span class="cart__total-label">Estimated total</span>
      <text-component ref="cartTotal" ...>{{ total_price }}</text-component>
      {% if settings.show_installments %}... payment_terms ...{% endif %}
      <div class="tax-note">{% render 'tax-info' %}</div>
    </div>
  </div>
  <div class="cart__ctas">
    <button id="checkout" form="cart-form">Checkout</button>
    {% if additional_checkout_buttons %}... content_for_additional_checkout_buttons ...{% endif %}
  </div>
{% endcomment %}
