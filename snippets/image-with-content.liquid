<div class="etu-card">
  <img src="{{ img | image_url: width: 750 }}" alt="image">
  
  <div class="etu-card__content">
    <div class="h4">{{ title }}</div>
    <div>{{ description }}</div>
  </div>
</div>

{% style %}
  .etu-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    border: 0.5px solid var(--border-color);
    padding: 1rem;
    border-radius: 2px;

    max-width: 450px;
    flex-shrink: 0;

    background: #fff;

    & img {
      height: 150px;
      object-fit: cover;
      border-radius: 2px;

      @media (min-width: 576px) {
        width: 155px;
        height: 100%;
        aspect-ratio: 1;
      }
    }

    & .etu-card__content {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;

      & .h4 {
        color: var(--color-foreground-heading);
      }
    }

    @media (min-width: 576px) {
      flex-direction: row;
      align-items: center;
    }
  }
{% endstyle %}