{% assign name_split = name | split: ' ' %}
{% assign name = name_split[0] %}

<div class='review-widget'>
  <div class='review-widget__top'>
    <div class='name-stars-wrapper'>
      <div class='name'>{{ name }}</div>
      <div class='stars'>
        {% assign rating = rating | times: 1 %}

        {% for i in (1..rating) %}
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 16 16'
            fill='none'
          >
            <path d="M8.00021 11.6682L5.22154 13.3428C5.08076 13.4312 4.93437 13.4691 4.78237 13.4567C4.63048 13.4442 4.49793 13.3938 4.38471 13.3055C4.27137 13.217 4.18359 13.1059 4.12137 12.972C4.05915 12.838 4.04737 12.6895 4.08604 12.5265L4.82337 9.36449L2.36137 7.23582C2.23437 7.1226 2.15498 6.99343 2.1232 6.84832C2.09143 6.70332 2.09909 6.56171 2.1462 6.42349C2.19332 6.28538 2.26993 6.17077 2.37604 6.07966C2.48226 5.98866 2.62243 5.93204 2.79654 5.90982L6.04187 5.62649L7.29987 2.64382C7.36343 2.48927 7.46082 2.37465 7.59204 2.29999C7.72337 2.22532 7.85943 2.18799 8.00021 2.18799C8.14098 2.18799 8.27704 2.22532 8.40837 2.29999C8.53959 2.37465 8.63698 2.48927 8.70054 2.64382L9.95854 5.62649L13.2039 5.90982C13.378 5.93204 13.5181 5.98866 13.6244 6.07966C13.7305 6.17077 13.8071 6.28538 13.8542 6.42349C13.9013 6.56171 13.909 6.70332 13.8772 6.84832C13.8454 6.99343 13.766 7.1226 13.639 7.23582L11.177 9.36449L11.9144 12.5265C11.953 12.6895 11.9413 12.838 11.879 12.972C11.8168 13.1059 11.729 13.217 11.6157 13.3055C11.5025 13.3938 11.3699 13.4442 11.218 13.4567C11.066 13.4691 10.9196 13.4312 10.7789 13.3428L8.00021 11.6682Z" fill="#FFCB52"/>
          </svg>
        {% endfor %}
      </div>
    </div>

    <div class='date'>{{ date | date: '%d/%b/%Y' }}</div>
  </div>

  <div class='review-widget__content'>
    <div class='content-title'>{{ title }}</div>
    <div class='content-paragraph'>{{ paragraph }}</div>
  </div>
</div>

{% style %}
  .review-widget {
    background: #fff;
    margin-block-end: 1rem;
    padding: 1rem;
    border-radius: 2px;

    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    color: #000;

    & .review-widget__top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;

      & .name-stars-wrapper {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        & .stars {
          display: flex;
        }

        & .name {
          font-size: var(--font-size--sm);
          font-weight: bold;
          opacity: 0.6;
        }
      }

      & .date {
        opacity: 0.5;
        font-size: var(--font-size--sm);
      }
    }

    & .review-widget__content {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;

      & .content-title {
        font-family: var(--font-heading--family);
        text-transform: uppercase;
      }

      & .content-paragraph {
        font-size: var(--font-size--sm);
        opacity: 0.75;
      }
    }
  }
{% endstyle %}
