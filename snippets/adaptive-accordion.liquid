{% comment %}
  adaptive accordion where image changes and accordion closes.
{% endcomment %}

{% liquid
  assign adaptive_accordion_metaobject = metaobjects.adaptive_accordion.values
%}

<div class='adaptive-accordion'>
  <div class='adaptive-accordion__media'>
    {% for item in adaptive_accordion_metaobject %}
      <img
        data-accordion='{{ forloop.index0 }}'
        {% unless forloop.first %}
          class='hidden'
        {% endunless %}
        src='{{ item.media | image_url: width: 500 }}'
        alt='{{ item.media.alt }}'
      >
    {% endfor %}
  </div>

  <div class='adaptive-accordion__accordions'>
    {% for item in adaptive_accordion_metaobject %}
      <div
        data-accordion='{{ forloop.index0 }}'
      >
        {{ item.accordion.value.question }}
        {{ item.accordion.value.answer }}
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .adaptive-accordion {
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: 48px;

    & .adaptive-accordion__media {
      flex: 1;
    }

    & .adaptive-accordion__accordions {
      flex: 1;
    }

    @media (min-width: 768px) {
      flex-direction: row;
    }
  }
{% endstyle %}
