{%- doc -%}
  Renders a contact form with name, email, phone, and comment fields.

  @param {object} settings - Block settings, required for the 'spacing-style' and 'size-style' snippets.
  @param {string} submit_button - HTML for the submit button, rendered via a `content_for` block.
  @param {object} block - Block object used for id and shopify attributes.
  @param {object} section - Section object used as fallback id source.

  @example
  {% render 'contact-form', settings: block.settings, submit_button: content_for_submit_button %}
{%- enddoc -%}

<div
  class='
    contact-form
    spacing-style size-style
    {% if settings.inherit_color_scheme == false %}color-{{ settings.color_scheme }}{% endif %}
  '
  style='
    {% render 'spacing-style', settings: settings %}
    {% render 'size-style', settings: settings %}
  '
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}

  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    {%- if form.errors -%}
      <div
        class='contact-form__error'
        tabindex='-1'
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}

        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        class='contact-form__success'
        tabindex='-1'
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        {{- 'blocks.contact_form.post_success' | t -}}
      </div>
    {%- endif -%}

    <div class='contact-form__field'>
      <label
        class='contact-form__label'
        for='{{ form_id }}-name'
      >
        <h5>FULL NAME</h5>
      </label>
      <input
        type='text'
        id='{{ form_id }}-name'
        class='contact-form__input'
        autocomplete='name'
        name='contact[name]'
        value='{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}'
        placeholder='John Smith'
      >
    </div>

    <div class='contact-form__field'>
      <label
        class='contact-form__label'
        for='{{ form_id }}-email'
      >
        <h5>EMAIL ADDRESS</h5>
      </label>
      <input
        type='email'
        id='{{ form_id }}-email'
        class='contact-form__input'
        autocomplete='email'
        name='contact[email]'
        spellcheck='false'
        autocapitalize='off'
        value='{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}'
        aria-required='true'
        {% if form.errors contains 'email' %}
          aria-invalid='true'
          aria-describedby='{{ form_id }}-email-error'
        {% endif %}
        placeholder='john@example.com'
      >
    </div>

    <div class='contact-form__field contact-form__form--where'>
      <label
        class='contact-form__label'
        for='{{ form_id }}-purchase-source'
      >
        <h5>WHERE DID YOU MAKE THIS PURCHASE?</h5>
      </label>
      <input
        type='text'
        id='{{ form_id }}-purchase-source'
        class='contact-form__input'
        name='contact[Purchase source]'
        placeholder='Where did you make this purchase?'
      >
    </div>

    <div class='contact-form__field'>
      <label
        class='contact-form__label'
        for='{{ form_id }}-country'
      >
        <h5>COUNTRY</h5>
      </label>
      <input
        type='text'
        id='{{ form_id }}-country'
        class='contact-form__input'
        name='contact[Country]'
        placeholder='Germany'
      >
    </div>

    <div class='contact-form__field'>
      <label
        class='contact-form__label'
        for='{{ form_id }}-order-number'
      >
        <h5>ORDER NUMBER</h5>
      </label>
      <input
        type='text'
        id='{{ form_id }}-order-number'
        class='contact-form__input'
        name='contact[Order number]'
        placeholder='1234567890'
      >
    </div>

    <div class='contact-form__field contact-form__form--message'>
      <label
        class='contact-form__label'
        for='{{ form_id }}-body'
      >
        <h5>MESSAGE</h5>
      </label>
      <textarea
        rows='10'
        id='{{ form_id }}-body'
        class='contact-form__input contact-form__input--textarea'
        name='contact[body]'
        placeholder='Tell us more about your inquiry...'
      >
        {{- form.body -}}
      </textarea>
    </div>

    {{ submit_button }}
  {% endform %}
</div>

{% style %}
  .contact-form {
    background: transparent;

    & .contact-form__form {
      display: flex;
      flex-direction: column;
      gap: 24px;
      
      @media (min-width: 576px) {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    
        grid-template-areas:
          'name email'
          'where where'
          'country order'
          'message message';
      }
  
      & .contact-form__field {
        display: flex;
        flex-direction: column;
        gap: 8px;
  
        & .contact-form__input {
          padding: 16px;
          border-radius: 4px;
          border: none;
        }
      }
  
      & .contact-form__form--where {
        grid-area: where;
      }
  
      & .contact-form__form--message {
        grid-area: message;
      }
    }
  }
{% endstyle %}

