    "about_proof_carousel": {
      "type": "about-proof-carousel",
      "blocks": {
        "testimonial_1": {
          "type": "testimonial",
          "settings": {
            "title": "Het werkt echt!",
            "text": "Ik was sceptisch, maar deze val ving meer vliegen in 24 uur dan mijn azijnval in een hele week. Elke cent waard.",
            "name": "David P."
          }
        },
        "testimonial_2": {
          "type": "testimonial",
          "settings": {
            "title": "Veilig en effectief",
            "text": "Fijn dat ik het kan gebruiken bij mijn kinderen en hond. Geen agressieve chemicaliën, en het werkt beter dan de spray die ik eerder gebruikte.",
            "name": "Rachel T."
          }
        },
        "testimonial_3": {
          "type": "testimonial",
          "settings": {
            "title": "Binnen een minuut klaar",
            "text": "In de keuken gezet en vergeten. Twee dagen later geen fruitvliegjes meer.",
            "name": "Mark L."
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "title": "Elke cent waard",
            "text": "Ik heb veel doe-het-zelf methoden geprobeerd, maar geen enkele werkte zo goed. Snel resultaat en geen rommel.",
            "name": "Olivia N."
          }
        },
        "testimonial_5": {
          "type": "testimonial",
          "settings": {
            "title": "Huisdiervriendelijk, eindelijk.",
            "text": "Eindelijk een product dat ik kan vertrouwen in een huis met huisdieren. Effectief en zonder stress.",
            "name": "Kevin S."
          }
        },
        "testimonial_6": {
          "type": "testimonial",
          "settings": {
            "title": "Dag, fruitvliegjes",
            "text": "De volgende ochtend al was het verschil enorm. Het huis voelt weer schoon en rustig aan.",
            "name": "Sophia R."
          }
        }
      },
      "block_order": [
